        local dataPing = 50
        pcall(function()
            dataPing = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        obj1.CFrame = CFrame.new(
            obj2.Position + obj2.Velocity * (dataPing / 1000) * 5
