UserInputService.InputChanged:Connect(function(input)
    if isDraggingZoom and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local trackAbsPos = ZoomTrack.AbsolutePosition.Y
        local trackAbsSize = ZoomTrack.AbsoluteSize.Y
        local mousePos = input.Position.Y

        local relativeY = math.clamp(mousePos - trackAbsPos, 0, trackAbsSize)
        local scale = relativeY / trackAbsSize

        ZoomKnob.Position = UDim2.new(0.5, -10, scale, -10)

        local targetFOV = 10 + (scale * 110)
        CurrentCamera.FieldOfView = targetFOV
    end
end)

-- LOGIC HỆ THỐNG SPECTATE PLAYER (TAB 2)
local isViewingCam = false
local isDraggingView = false
local lastInputPos = nil
local yaw = 0
local pitch = 0

local function ExitCamView()
    isViewingCam = false
    spectateTarget = nil
    if spectateConnection then
        spectateConnection:Disconnect()
        spectateConnection = nil
    end

    CurrentCamera.CameraType = Enum.CameraType.Custom
    CurrentCamera.FieldOfView = 70
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        CurrentCamera.CameraSubject = LocalPlayer.Character.Humanoid
    end

    ZoomSliderFrame.Visible = false
    CamControlBar.Visible = false
    QuickExitBtn.Visible = false
end

local function SpectatePlayer(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then return end
    spectateTarget = targetPlayer

    if spectateConnection then spectateConnection:Disconnect() spectateConnection = nil end

    isViewingCam = true
    CamControlBar.Visible = true
    QuickExitBtn.Visible = true
    OptionMenu.Visible = false
    SpectateNameLabel.Text = "👀 Đang Xem: " .. targetPlayer.DisplayName

    if spectateMode == "Normal" then
        ZoomSliderFrame.Visible = true
        spectateConnection = RunService.RenderStepped:Connect(function()
            if spectateTarget and spectateTarget.Character and spectateTarget.Character:FindFirstChild("Humanoid") then
                CurrentCamera.CameraType = Enum.CameraType.Custom
                CurrentCamera.CameraSubject = spectateTarget.Character.Humanoid
            else
                ExitCamView()
            end
        end)
    elseif spectateMode == "FirstPerson" then
        ZoomSliderFrame.Visible = false
        CurrentCamera.CameraType = Enum.CameraType.Scriptable

        spectateConnection = RunService.RenderStepped:Connect(function()
            if spectateTarget and spectateTarget.Character and spectateTarget.Character:FindFirstChild("Head") then
                local head = spectateTarget.Character.Head
                CurrentCamera.CFrame = head.CFrame * CFrame.new(0, 0, -0.2)
            else
                ExitCamView()
            end
        end)
    end
end

-- LOGIC XOAY 360° MÀN HÌNH BẰNG TAY DÀNH CHO CAM ĐẶT TAB 1
local function ViewCamAtIndex(index)
    if #PlacedCameras == 0 then return end
    
    -- TỰ ĐỘNG LẶP CHO CAM ĐẶT TAB 1
    if index < 1 then index = #PlacedCameras end
    if index > #PlacedCameras then index = 1 end

    currentCamIndex = index
    local data = PlacedCameras[currentCamIndex]

    if data and data.Part and data.Part.Parent then
        spectateTarget = nil
        if spectateConnection then spectateConnection:Disconnect() spectateConnection = nil end

        CurrentCamera.CameraType = Enum.CameraType.Scriptable
        CurrentCamera.CFrame = data.Part.CFrame * CFrame.new(0, 0, -1.2)
        
        local rx, ry, rz = CurrentCamera.CFrame:ToOrientation()
        yaw = math.deg(ry)
        pitch = math.deg(rx)

        isViewingCam = true
        ZoomSliderFrame.Visible = true
        CamControlBar.Visible = true
        QuickExitBtn.Visible = true
        OptionMenu.Visible = false
        SpectateNameLabel.Text = "📷 " .. data.Name
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if isViewingCam and not gameProcessed then
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingView = true
            lastInputPos = input.Position
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingView = false
        lastInputPos = nil
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isViewingCam and isDraggingView and lastInputPos and CurrentCamera.CameraType == Enum.CameraType.Scriptable and not spectateTarget then
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - lastInputPos
            lastInputPos = input.Position

            yaw = yaw - delta.X * 0.3
            pitch = math.clamp(pitch - delta.Y * 0.3, -80, 80)

            local currentPos = CurrentCamera.CFrame.Position
            CurrentCamera.CFrame = CFrame.new(currentPos) * CFrame.Angles(0, math.rad(yaw), 0) * CFrame.Angles(math.rad(pitch), 0, 0)
        end
    end
end)

-- 🔄 TỰ ĐỘNG LẶP VÒNG KHI BẤM NÚT QUA LẠI (< / >)
PrevCamBtn.MouseButton1Click:Connect(function()
    if spectateTarget then
        local pList = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then table.insert(pList, p) end
        end
        if #pList == 0 then return end
        
        local currentIdx = table.find(pList, spectateTarget) or 1
        local newIdx = currentIdx - 1
        
        -- Lặp về người chơi cuối cùng nếu đang ở đầu
        if newIdx < 1 then newIdx = #pList end
        SpectatePlayer(pList[newIdx])
    else
        ViewCamAtIndex(currentCamIndex - 1)
    end
end)

NextCamBtn.MouseButton1Click:Connect(function()
    if spectateTarget then
        local pList = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then table.insert(pList, p) end
        end
        if #pList == 0 then return end
        
        local currentIdx = table.find(pList, spectateTarget) or 1
        local newIdx = currentIdx + 1
        
        -- Lặp về người chơi đầu tiên nếu đang ở cuối
        if newIdx > #pList then newIdx = 1 end
        SpectatePlayer(pList[newIdx])
    else
        ViewCamAtIndex(currentCamIndex + 1)
    end
end)

