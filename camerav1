-- TẠO MÔ HÌNH CAMERA 3D
local function CreateBeautifulCameraModel(startCFrame)
    local model = Instance.new("Model")
    model.Name = "BeautifulCameraModel"

    local body = Instance.new("Part")
    body.Name = "Body"
    body.Size = Vector3.new(0.9, 0.7, 1.2)
    body.Color = Color3.fromRGB(25, 25, 30)
    body.Material = Enum.Material.SmoothPlastic
    body.Anchored = true
    body.CanCollide = false
    body.CFrame = startCFrame
    body.Parent = model

    local rim = Instance.new("Part")
    rim.Size = Vector3.new(0.92, 0.1, 1.22)
    rim.Color = Color3.fromRGB(218, 165, 32)
    rim.Material = Enum.Material.Metal
    rim.Anchored = true
    rim.CanCollide = false
    rim.CFrame = body.CFrame * CFrame.new(0, 0, 0)
    rim.Parent = model

    local lensOuter = Instance.new("Part")
    lensOuter.Shape = Enum.PartType.Cylinder
    lensOuter.Size = Vector3.new(0.8, 0.7, 0.7)
    lensOuter.Color = Color3.fromRGB(15, 15, 20)
    lensOuter.Material = Enum.Material.SmoothPlastic
    lensOuter.Anchored = true
    lensOuter.CanCollide = false
    lensOuter.CFrame = body.CFrame * CFrame.new(0, 0, -0.7) * CFrame.Angles(0, 0, math.rad(90))
    lensOuter.Parent = model

    local lensGlass = Instance.new("Part")
    lensGlass.Shape = Enum.PartType.Cylinder
    lensGlass.Size = Vector3.new(0.05, 0.6, 0.6)
    lensGlass.Color = Color3.fromRGB(0, 190, 255)
    lensGlass.Material = Enum.Material.Neon
    lensGlass.Anchored = true
    lensGlass.CanCollide = false
    lensGlass.CFrame = body.CFrame * CFrame.new(0, 0, -1.1) * CFrame.Angles(0, 0, math.rad(90))
    lensGlass.Parent = model

    local led = Instance.new("Part")
    led.Size = Vector3.new(0.15, 0.15, 0.15)
    led.Color = Color3.fromRGB(255, 30, 30)
    led.Material = Enum.Material.Neon
    led.Anchored = true
    led.CanCollide = false
    led.CFrame = body.CFrame * CFrame.new(0.3, 0.25, -0.5)
    led.Parent = model

    model.PrimaryPart = body
    model.Parent = Workspace
    return model, body
end

-- LOGIC DI CHUYỂN / XOAY BẰNG NÚT
local holdingAction = nil
local activeConnection = nil

local function StartHoldAction(actionFunc)
    holdingAction = actionFunc
    if activeConnection then activeConnection:Disconnect() end
    activeConnection = RunService.RenderStepped:Connect(function()
        if holdingAction and TempCamModel and TempMainPart then
            holdingAction()
        end
    end)
end

local function StopHoldAction()
    holdingAction = nil
    if activeConnection then
        activeConnection:Disconnect()
        activeConnection = nil
    end
end

local moveSpeed = 0.4
local rotSpeed = 4.5

local function BindHold(button, actionFunc)
    button.MouseButton1Down:Connect(function() StartHoldAction(actionFunc) end)
    button.MouseButton1Up:Connect(StopHoldAction)
    button.MouseLeave:Connect(StopHoldAction)
end

BindHold(MoveFwd, function() TempCamModel:SetPrimaryPartCFrame(TempMainPart.CFrame * CFrame.new(0, 0, -moveSpeed)) end)
BindHold(MoveBack, function() TempCamModel:SetPrimaryPartCFrame(TempMainPart.CFrame * CFrame.new(0, 0, moveSpeed)) end)
BindHold(MoveLeft, function() TempCamModel:SetPrimaryPartCFrame(TempMainPart.CFrame * CFrame.new(-moveSpeed, 0, 0)) end)
BindHold(MoveRight, function() TempCamModel:SetPrimaryPartCFrame(TempMainPart.CFrame * CFrame.new(moveSpeed, 0, 0)) end)
BindHold(MoveUp, function() TempCamModel:SetPrimaryPartCFrame(TempMainPart.CFrame * CFrame.new(0, moveSpeed, 0)) end)
BindHold(MoveDown, function() TempCamModel:SetPrimaryPartCFrame(TempMainPart.CFrame * CFrame.new(0, -moveSpeed, 0)) end)

BindHold(RotUp, function() TempCamModel:SetPrimaryPartCFrame(TempMainPart.CFrame * CFrame.Angles(math.rad(rotSpeed), 0, 0)) end)
BindHold(RotDown, function() TempCamModel:SetPrimaryPartCFrame(TempMainPart.CFrame * CFrame.Angles(math.rad(-rotSpeed), 0, 0)) end)
BindHold(RotLeft, function() TempCamModel:SetPrimaryPartCFrame(TempMainPart.CFrame * CFrame.Angles(0, math.rad(rotSpeed), 0)) end)
BindHold(RotRight, function() TempCamModel:SetPrimaryPartCFrame(TempMainPart.CFrame * CFrame.Angles(0, math.rad(-rotSpeed), 0)) end)

ReverseBtn.MouseButton1Click:Connect(function()
    if TempCamModel and TempMainPart then
        TempCamModel:SetPrimaryPartCFrame(TempMainPart.CFrame * CFrame.Angles(0, math.rad(180), 0))
    end
end)

