const LRU = (capacity = 512) => {
    const cache = new Map();
    return {
        get(key) {
            if (!cache.has(key)) return undefined;
            const value = cache.get(key);
            cache.delete(key);
            cache.set(key, value);
            return value;
        },
        set(key, value) {
            if (cache.has(key)) cache.delete(key);
            else if (cache.size >= capacity) cache.delete(cache.keys().next().value);
            cache.set(key, value);
        },
        has(key) { return cache.has(key); },
        get size() { return cache.size; }
    };
};

const semaphore = (slots) => {
    let active = slots;
    const queue = [];
    return {
        acquire: () => active > 0 ? Promise.resolve(active--) : new Promise(r => queue.push(() => r(active--))),
        release: () => { active++; const next = queue.shift(); if (next) next(); },
        get pending() { return queue.length; }
    };
};

