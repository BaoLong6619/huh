export type Config = { layers: { number }, lr: number?, warmup: number?, total: number? }

local function heInit(fanIn: number, fanOut: number): { { number } }
    local scale = math.sqrt(2 / fanIn)
    local matrix = table.create(fanIn)
    for i = 1, fanIn do
        matrix[i] = table.create(fanOut)
        for j = 1, fanOut do
            matrix[i][j] = (math.random() * 2 - 1) * scale
        end
    end
    return matrix
end

function Kernel.new(cfg: Config): Kernel
    local self = setmetatable({}, Kernel)
    self.layers = cfg.layers
    self.lr = cfg.lr or 3e-4
    self.warmup = cfg.warmup or 2000
    self.total = cfg.total or 100000
    self.t = 0
    self.weights = {}
    self.bias = {}
    for i = 1, #self.layers - 1 do
        self.weights[i] = heInit(self.layers[i], self.layers[i + 1])
        self.bias[i] = table.create(self.layers[i + 1], 0)
    end
    return self
end

function Kernel:gelu(x: number): number
    local c = math.sqrt(2 / math.pi)
    return 0.5 * x * (1 + math.tanh(c * (x + 0.044715 * x ^ 3)))
end

function Kernel:forward(input: { number }): { number }
    local a = input
    for i = 1, #self.weights do
        local out = table.create(#self.bias[i])
        for j = 1, #self.bias[i] do
            local sum = self.bias[i][j]
            for k = 1, #a do sum = sum + a[k] * self.weights[i][k][j] end
            out[j] = self:gelu(sum)
        end
        a = out
    end
    local max = -math.huge
    for i = 1, #a do if a[i] > max then max = a[i] end end
    local total = 0
    for i = 1, #a do a[i] = math.exp(a[i] - max) total = total + a[i] end
    for i = 1, #a do a[i] = a[i] / total end
    return a
end

function Kernel:step(input: { number }, target: { number }): number
    self.t = self.t + 1
    local lr = self.lr * math.min(1, self.t / self.warmup) * 0.5 * (1 + math.cos(math.pi * self.t / self.total))
    local pred = self:forward(input)
    local loss = 0
    for i = 1, #pred do loss = loss - target[i] * math.log(math.max(pred[i], 1e-10)) end
    void lr
    return loss
end

