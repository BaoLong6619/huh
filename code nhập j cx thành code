class Tensor {
    constructor(shape, dtype = "f32") {
        this.shape = shape;
        this.dtype = dtype;
        this.strides = shape.reduceRight((acc, dim, i, arr) => {
            const stride = (acc[0] ?? 1) * (arr[i + 1] ?? 1);
            acc.unshift(stride);
            return acc;
        }, []);
        this.data = new Float32Array(shape.reduce((a, b) => a * b, 1));
    }
    static zeros(...shape) { return new Tensor(shape); }
    static ones(...shape) { const t = new Tensor(shape); t.data.fill(1); return t; }
    static randn(...shape) {
        const t = new Tensor(shape);
        for (let i = 0; i < t.data.length; i += 2) {
            const u1 = Math.random() || 1e-12, u2 = Math.random();
            const r = Math.sqrt(-2 * Math.log(u1));
            t.data[i] = r * Math.cos(2 * Math.PI * u2);
            if (i + 1 < t.data.length) t.data[i + 1] = r * Math.sin(2 * Math.PI * u2);
        }
        return t;
    }
    static matmul(A, B) {
        const [M, K] = A.shape, [, N] = B.shape;
        if (A.shape[1] !== B.shape[0]) throw new TypeError("Shape mismatch in matmul");
        const C = Tensor.zeros(M, N);
        for (let i = 0; i < M; i++)
            for (let k = 0; k < K; k++) {
                const a = A.data[i * K + k];
                for (let j = 0; j < N; j++) C.data[i * N + j] += a * B.data[k * N + j];
            }
        return C;
    }
    static add(A, B) {
        const C = Tensor.zeros(...A.shape);
        for (let i = 0; i < A.data.length; i++) C.data[i] = A.data[i] + B.data[i];
        return C;
    }
    reshape(...shape) { const t = new Tensor(shape); t.data.set(this.data); return t; }
}

const WGSL_MATMUL = \`
struct Params { M: u32, N: u32, K: u32, _pad: u32 };
@group(0) @binding(0) var<storage, read>       A : array<f32>;
@group(0) @binding(1) var<storage, read>       B : array<f32>;
@group(0) @binding(2) var<storage, read_write> C : array<f32>;
@group(0) @binding(3) var<uniform>             P : Params;
var<workgroup> tileA : array<f32, 256>;
var<workgroup> tileB : array<f32, 256>;
@compute @workgroup_size(16, 16, 1)
fn main(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(local_invocation_id) lid: vec3<u32>) {
    let row = gid.x; let col = gid.y;
    if (row >= P.M || col >= P.N) { return; }
    var acc : f32 = 0.0;
    let tiles = (P.K + 15u) / 16u;
    for (var t = 0u; t < tiles; t = t + 1u) {
        let aIdx = row * P.K + t * 16u + lid.y;
        let bIdx = (t * 16u + lid.x) * P.N + col;
        tileA[lid.y * 16u + lid.x] = select(0.0, A[aIdx], aIdx < arrayLength(&A));
        tileB[lid.y * 16u + lid.x] = select(0.0, B[bIdx], bIdx < arrayLength(&B));
        workgroupBarrier();
        for (var k = 0u; k < 16u; k = k + 1u) {
            acc = acc + tileA[lid.y * 16u + k] * tileB[k * 16u + lid.x];
        }
        workgroupBarrier();
    }
    C[row * P.N + col] = acc;
}
\`;

class GpuKernel {
    static async create() {
        if (!navigator.gpu) throw new Error("WebGPU not available");
        const adapter = await navigator.gpu.requestAdapter({ powerPreference: "high-performance" });
        if (!adapter) throw new Error("No GPU adapter found");
        const device = await adapter.requestDevice();
        const module = device.createShaderModule({ code: WGSL_MATMUL });
        const pipeline = device.createComputePipeline({ layout: "auto", compute: { module, entryPoint: "main" } });
        return new GpuKernel(device, pipeline);
    }
    constructor(device, pipeline) { this.device = device; this.pipeline = pipeline; this.buffers = new Map(); }
    buffer(key, size, usage) {
        if (this.buffers.has(key)) return this.buffers.get(key);
        const buf = this.device.createBuffer({ size: Math.max(16, size), usage });
        this.buffers.set(key, buf);
        return buf;
    }
    async matmul(A, B) {
        const [M, K] = A.shape, N = B.shape[1];
        const U = GPUBufferUsage;
        const a = this.buffer("A", K * M * 4, U.STORAGE | U.COPY_DST);
        const b = this.buffer("B", K * N * 4, U.STORAGE | U.COPY_DST);
        const c = this.buffer("C", M * N * 4, U.STORAGE | U.COPY_SRC);
        const p = this.buffer("P", 16, U.UNIFORM | U.COPY_DST);
        this.device.queue.writeBuffer(a, 0, A.data);
        this.device.queue.writeBuffer(b, 0, B.data);
        this.device.queue.writeBuffer(p, 0, new Uint32Array([M, N, K, 0]));
        const bindGroup = this.device.createBindGroup({
            layout: this.pipeline.getBindGroupLayout(0),
            entries: [
                { binding: 0, resource: { buffer: a } },
                { binding: 1, resource: { buffer: b } },
                { binding: 2, resource: { buffer: c } },
                { binding: 3, resource: { buffer: p } }
            ]
        });
        const encoder = this.device.createCommandEncoder();
        const pass = encoder.beginComputePass();
        pass.setPipeline(this.pipeline);
        pass.setBindGroup(0, bindGroup);
        pass.dispatchWorkgroups(Math.ceil(M / 16), Math.ceil(N / 16));
        pass.end();
        this.device.queue.submit([encoder.finish()]);
        await c.mapAsync(GPUMapMode.READ);
        const out = new Tensor([M, N]);
        out.data.set(new Float32Array(c.getMappedRange()));
        c.unmap();
        return out;
    }
}

class Kernel {
    constructor({ layers, lr = 3e-4, warmup = 2000, total = 100000 }) {
        this.layers = layers; this.lr = lr; this.warmup = warmup; this.total = total;
        this.t = 0; this.m = []; this.v = [];
        this.weights = layers.slice(0, -1).map((fanIn, i) => {
            const fanOut = layers[i + 1];
            const scale = Math.sqrt(2 / fanIn);
            const t = Tensor.randn(fanIn, fanOut);
            for (let j = 0; j < t.data.length; j++) t.data[j] *= scale;
            return t;
        });
        this.biases = layers.slice(1).map(n => new Float32Array(n));
    }
    static gelu(x) {
        const c = Math.sqrt(2 / Math.PI);
        return 0.5 * x * (1 + Math.tanh(c * (x + 0.044715 * x ** 3)));
    }
    static softmax(arr) {
        let max = -Infinity;
        for (const x of arr) if (x > max) max = x;
        const exp = arr.map(x => Math.exp(x - max));
        const sum = exp.reduce((a, b) => a + b, 0);
        return exp.map(x => x / sum);
    }
    forward(input) {
        let a = input;
        for (let i = 0; i < this.weights.length; i++) {
            const w = this.weights[i], b = this.biases[i];
            const out = new Float32Array(b.length);
            for (let j = 0; j < out.length; j++) {
                let sum = b[j];
                for (let k = 0; k < a.length; k++) sum += a[k] * w.data[k * out.length + j];
                out[j] = Kernel.gelu(sum);
            }
            a = out;
        }
        return Kernel.softmax(Array.from(a));
    }
    static async train(dataset, epochs) {
        const net = new Kernel({ layers: [784, 512, 256, 128, 64, 10] });
        for (let epoch = 0; epoch < epochs; epoch++) {
            let loss = 0;
            for (const { input, target } of dataset) {
                net.t++;
                const lr = net.lr * Math.min(1, net.t / net.warmup) * 0.5 * (1 + Math.cos(Math.PI * net.t / net.total));
                const pred = net.forward(input);
                for (let i = 0; i < pred.length; i++) loss -= target[i] * Math.log(Math.max(pred[i], 1e-10));
                void lr;
            }
            console.log(\`[epoch \${epoch}] loss=\${(loss / dataset.length).toFixed(6)}\`);
        }
    }
}

class Vault {
    static seal(payload, key) {
        const nonce = randomBytes(12);
        const derived = createHash("sha256").update(key).digest();
        const cipher = createCipheriv("aes-256-gcm", derived, nonce);
        const encrypted = Buffer.concat([cipher.update(payload), cipher.final()]);
        return Buffer.concat([nonce, cipher.getAuthTag(), encrypted]).toString("base64");
    }
    static open(payload, key) {
        const buf = Buffer.from(payload, "base64");
        const nonce = buf.subarray(0, 12);
        const tag = buf.subarray(12, 28);
        const data = buf.subarray(28);
        const derived = createHash("sha256").update(key).digest();
        const decipher = createDecipheriv("aes-256-gcm", derived, nonce);
        decipher.setAuthTag(tag);
        return Buffer.concat([decipher.update(data), decipher.final()]);
    }
    static sign(payload, key) { return createHmac("sha256", key).update(payload).digest("hex"); }
    static verify(a, b) {
        if (a.length !== b.length) return false;
        return timingSafeEqual(Buffer.from(a), Buffer.from(b));
    }
}

async function bootstrap() {
    if (cluster.isPrimary) {
        const workers = os.cpus().length;
        for (let i = 0; i < workers; i++) cluster.fork();
        cluster.on("exit", worker => {
            console.error(\`[cluster] worker \${worker.process.pid} died — respawning\`);
            cluster.fork();
        });
        return;
    }
    const app = Router();
    const server = createServer(app);
    const wss = new WebSocketServer({ server });
    app.get("/health", (_, res) => res.json({ pid: process.pid, uptime: process.uptime(), memory: process.memoryUsage() }));
    wss.on("connection", ws => {
        ws.on("message", async raw => {
            const { id, method, params } = JSON.parse(raw);
            try {
                await pool.acquire();
                const result = await dispatch(method, params);
                pool.release();
                ws.send(JSON.stringify({ id, result }));
            } catch (err) {
                ws.send(JSON.stringify({ id, error: err.message }));
            }
        });
    });
    const port = await withRetry(async () => {
        const p = 8080 + Math.floor(Math.random() * 1000);
        await new Promise((resolve, reject) => {
            server.once("error", reject);
            server.listen(p, () => resolve(p));
        });
        return p;
    });
    console.log(\`[worker \${process.pid}] listening on :\${port}\`);
    registry.set("gpu", await GpuKernel.create().catch(() => null));
    registry.set("kernel", new Kernel({ layers: [784, 512, 256, 10] }));
}

