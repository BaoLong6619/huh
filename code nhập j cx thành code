        const last = codeBox.lastChild;
        if (last && last !== freeStartNode && last !== cursor) {
            codeBox.removeChild(last);
            screen.scrollTop = screen.scrollHeight;
        }
    }
    
    function onKeyDown(e) {
        if (e.key === 'Escape') {
            screen.remove();
            style.remove();
            document.removeEventListener('keydown', onKeyDown);
            console.log('%c👋 Đã thoát', 'color:#00ff41;font-size:14px');
            return;
        }
        
        e.preventDefault();
        e.stopPropagation();
        
        if (e.key === ';') {
            if (freeMode) tatFreeMode();
            else batFreeMode();
            return;
        }
        
        if (freeMode) {
            if (e.key === 'Backspace') { xoaChuFree(); return; }
            if (e.key === 'Enter') { goChuFree('\n'); return; }
            if (e.key.length === 1) goChuFree(e.key);
            return;
        }
        
        if (e.key === 'Enter') { inDongLoi(); return; }
        
        goChuThuong();
    }
    
    document.addEventListener('keydown', onKeyDown);
    screen.addEventListener('click', () => {
        if (!freeMode) goChuThuong();
    });
    
    console.log('%c💻 HACKER TYPER', 'color:#00ff41;font-size:20px;font-weight:bold;text-shadow:0 0 10px #00ff41');
    console.log('%c⌨️ Gõ phím = Node.js + WebGPU + Luau • Enter = báo lỗi', 'color:#00ff41;font-size:13px');
    console.log('%c; = bật/tắt chế độ gõ tự do', 'color:#ffc800;font-size:13px');
    console.log('%c🚪 ESC thoát', 'color:#00ff41;font-size:13px');
})();
