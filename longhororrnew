--// ===== ANIMATION LOOP =====
RunService.RenderStepped:Connect(function(dt)
    if not Main.Visible or not _G.LongGuiEffects.Animations then return end

    if _G.LongGuiEffects.BlackHole then
        BH.Visible = true
        for _, g in ipairs(Glows) do
            if g.frame.Parent then
                g.frame.BackgroundTransparency = g.base + math.sin(tick() * 1.5 + g.phase) * 0.03
            end
        end
        DG.Offset = Vector2.new(math.sin(tick() * 0.4) * 0.18, 0)
        FDG.Offset = Vector2.new(math.sin(tick() * 0.5 + 2) * 0.18, 0)
        local pu = 1 + math.sin(tick() * 2.5) * 0.035
        local ps = 128 * pu
        PR.Size = UDim2.new(0, ps, 0, ps)
        PR.Position = UDim2.new(0.5, -ps/2, 0.5, -ps/2)
        PRS.Transparency = 0.05 + math.sin(tick() * 3) * 0.08
        PRS.Thickness = 2 + math.sin(tick() * 2) * 0.4

        for _, p in ipairs(Parts) do
            if not p.f.Parent then continue end
            p.a = p.a + dt * p.sp * 2.2
            p.r = p.r - dt * 30
            if p.r < 65 then
                p.r = math.random(115, 145)
                p.a = math.random() * math.pi * 2
            end
            local cx = BHS/2 + math.cos(p.a) * p.r - p.f.Size.X.Offset/2
            local cy = BHS/2 + math.sin(p.a) * p.r * 0.35 - p.f.Size.Y.Offset/2
            p.f.Position = UDim2.new(0, cx, 0, cy)
            p.f.BackgroundTransparency = math.clamp((p.r - 55) / 110, 0.05, 0.85)
        end
    else
        BH.Visible = false
    end

    if _G.LongGuiEffects.Starfield then
        SF.Visible = true
        for _, s in ipairs(Stars) do
            if not s.f.Parent then continue end
            local p = s.f.Position
            local ny = p.Y.Scale + s.sp * dt * 0.09
            if ny > 1 then
                ny = -0.02
                s.f.Position = UDim2.new(math.random(), 0, ny, 0)
            else
                s.f.Position = UDim2.new(p.X.Scale, 0, ny, 0)
            end
            s.ph = s.ph + dt * 3
            s.f.BackgroundTransparency = 0.4 + math.sin(s.ph) * 0.3
        end
    else
        SF.Visible = false
    end
end)

--// ==========================================================
--  MOUSE UNLOCK (override game lock mỗi frame)
--// ==========================================================
local mouseUnlockConn = nil

local function SetMouseUnlocked(state)
    if state then
        if mouseUnlockConn then return end
        pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.Default end)
        pcall(function() UserInputService.MouseIconEnabled = true end)
        mouseUnlockConn = RunService.RenderStepped:Connect(function()
            if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
                pcall(function()
                    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                end)
            end
            if not UserInputService.MouseIconEnabled then
                pcall(function()
                    UserInputService.MouseIconEnabled = true
                end)
            end
        end)
    else
        if mouseUnlockConn then
            mouseUnlockConn:Disconnect()
            mouseUnlockConn = nil
        end
    end
end

