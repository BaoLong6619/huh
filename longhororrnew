local ChamsActive = false
local ChamsList = {}
local Connections = {}
local COLOR_PLAYER = Color3.fromRGB(0, 255, 0)
local COLOR_MONSTER = Color3.fromRGB(255, 0, 0)
local COLOR_WHITE = Color3.fromRGB(255, 255, 255)

local function AddChams(model)
    if ChamsList[model] then return end
    ChamsList[model] = true
    local isPlayer = Players:GetPlayerFromCharacter(model)
    local color = isPlayer and COLOR_PLAYER or COLOR_MONSTER
    local h = Instance.new("Highlight")
    h.Name = "LB_Chams"
    h.FillColor = color
    h.FillTransparency = 0.4
    h.OutlineColor = COLOR_WHITE
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = model
end

local function RemoveChams(model)
    ChamsList[model] = nil
    local h = model:FindFirstChild("LB_Chams")
    if h then h:Destroy() end
end

local function ClearAllChams()
    for model in pairs(ChamsList) do
        local h = model:FindFirstChild("LB_Chams")
        if h then h:Destroy() end
    end
    ChamsList = {}
end

local function IsValidTarget(model)
    if not model:IsA("Model") then return false end
    if model == LP.Character then return false end
    if Players:GetPlayerFromCharacter(model) then return true end
    if model:FindFirstChild("Humanoid") and model:FindFirstChild("HumanoidRootPart") then return true end
    return false
end

local function WatchPlayers()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then AddChams(p.Character) end
    end
    table.insert(Connections, Players.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function(c)
            task.wait(0.3)
            if ChamsActive then AddChams(c) end
        end)
    end))
    table.insert(Connections, Players.PlayerRemoving:Connect(function(p)
        if p.Character then RemoveChams(p.Character) end
    end))
end

local function WatchMonsters()
    for _, m in pairs(Workspace:GetDescendants()) do
        if IsValidTarget(m) then AddChams(m) end
    end
    table.insert(Connections, Workspace.DescendantAdded:Connect(function(d)
        if ChamsActive and d:IsA("Model") then
            task.delay(0.2, function()
                if d.Parent and IsValidTarget(d) then AddChams(d) end
            end)
        end
    end))
end

local function ToggleChams(s)
    ChamsActive = s
    if s then
        for _, c in pairs(Connections) do c:Disconnect() end
        Connections = {}
        WatchPlayers()
        WatchMonsters()
    else
        for _, c in pairs(Connections) do c:Disconnect() end
        Connections = {}
        ClearAllChams()
    end
end

--// ===== NOCLIP (restore siêu nhanh khi tắt) =====
local noclipConn = nil
local noclipSaved = {}
local noclipCharConn = nil

local function RestoreNoclipFast()
    task.spawn(function()
        local char = LP.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    local orig = noclipSaved[part]
                    if orig ~= nil then
                        part.CanCollide = orig
                    else
                        if part.Name == "HumanoidRootPart" or part.Name == "Head"
                           or part.Name == "Torso" or part.Name == "UpperTorso"
                           or part.Name == "LowerTorso" then
                            part.CanCollide = true
                        elseif part:FindFirstChildOfClass("Motor6D") == nil
                           and part.Name ~= "Handle" then
                            part.CanCollide = true
                        end
                    end
                end
            end
        end
        noclipSaved = {}
    end)
end

local function ToggleNoclip(s)
    if s then
        if noclipConn then return end
        noclipSaved = {}
        noclipConn = RunService.Stepped:Connect(function()
            local char = LP.Character
            if not char then return end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    if noclipSaved[part] == nil then
                        noclipSaved[part] = part.CanCollide
                    end
                    part.CanCollide = false
                end
            end
        end)
        if noclipCharConn then noclipCharConn:Disconnect() end
        noclipCharConn = LP.CharacterAdded:Connect(function(newChar)
            noclipSaved = {}
            task.wait(0.1)
            for _, part in ipairs(newChar:GetDescendants()) do
                if part:IsA("BasePart") then
                    noclipSaved[part] = part.CanCollide
                end
            end
        end)
    else
        if noclipConn then noclipConn:Disconnect() noclipConn = nil end
        if noclipCharConn then noclipCharConn:Disconnect() noclipCharConn = nil end
        RestoreNoclipFast()
    end
end

