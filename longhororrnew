local function Slider(parent, text, min, max, default, callback)
    local value = default or min
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 52)
    f.BackgroundTransparency = 1
    f.ZIndex = 17
    f.Parent = parent

    local l = Instance.new("TextLabel")
