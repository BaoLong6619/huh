-- Variables Logic
local SelectedTargets = {}
local FlingActive = false
local IsRunning = true
local SearchText = ""

-- Notification Center
local function Message(TxtTitle, TxtText, Time)
    StarterGui:SetCore("SendNotification", {
        Title = TxtTitle,
        Text = TxtText,
        Duration = Time or 5
    })
end

-- Count Targets
local function CountSelectedTargets()
    local count = 0
    for _ in pairs(SelectedTargets) do
        count += 1
    end
    return count
end

-- Update Status UI
local function UpdateStatus()
    local count = CountSelectedTargets()
    if FlingActive then
        StatusLabel.Text = "🎯 Flinging target..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    else
        StatusLabel.Text = count .. " target selected"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end

-- Stop Fling Function
local function StopFling()
    if not FlingActive then return end
    FlingActive = false
    UpdateStatus()
    Message("Stopped", "Fling has been stopped", 2)
end

-- Refresh Player List WITHOUT Resetting Entire UI
local function UpdatePlayerListNonDestructive()
    local currentPlayers = {}
    local filter = SearchText:lower()
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Player then
            local pName = player.Name:lower()
            local pDisplayName = player.DisplayName:lower()
            
            if filter == "" or pName:find(filter, 1, true) or pDisplayName:find(filter, 1, true) then
                currentPlayers[player.Name] = true
                local existingButton = PlayerScrollFrame:FindFirstChild(player.Name)
                
                if not existingButton then
                    local Entry = Instance.new("TextButton")
                    Entry.Name = player.Name
                    Entry.Size = UDim2.new(1, -10, 0, 42)
                    Entry.BackgroundColor3 = SelectedTargets[player.Name] and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(50, 50, 50)
                    Entry.Text = ""
                    Entry.AutoButtonColor = true
                    Entry.Parent = PlayerScrollFrame

                    local Corner = Instance.new("UICorner")
                    Corner.CornerRadius = UDim.new(0, 6)
                    Corner.Parent = Entry

                    -- Display Name
                    local DisplayNameLabel = Instance.new("TextLabel")
                    DisplayNameLabel.Size = UDim2.new(1, -75, 0, 20)
                    DisplayNameLabel.Position = UDim2.new(0, 8, 0, 3)
                    DisplayNameLabel.BackgroundTransparency = 1
                    DisplayNameLabel.Text = player.DisplayName
                    DisplayNameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    DisplayNameLabel.Font = Enum.Font.SourceSansBold
                    DisplayNameLabel.TextSize = 15
                    DisplayNameLabel.TextXAlignment = Enum.TextXAlignment.Left
                    DisplayNameLabel.Parent = Entry

                    -- Username với dấu @
                    local UsernameLabel = Instance.new("TextLabel")
                    UsernameLabel.Size = UDim2.new(1, -75, 0, 16)
                    UsernameLabel.Position = UDim2.new(0, 8, 0, 21)
                    UsernameLabel.BackgroundTransparency = 1
                    UsernameLabel.Text = "@" .. player.Name
                    UsernameLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
                    UsernameLabel.Font = Enum.Font.SourceSans
                    UsernameLabel.TextSize = 12
                    UsernameLabel.TextXAlignment = Enum.TextXAlignment.Left
                    UsernameLabel.Parent = Entry

                    -- Avatar bên phải 🖼️👉
                    local AvatarImg = Instance.new("ImageLabel")
                    AvatarImg.Size = UDim2.new(0, 30, 0, 30)
                    AvatarImg.Position = UDim2.new(1, -36, 0.5, -15)
                    AvatarImg.BackgroundTransparency = 1
                    pcall(function()
                        AvatarImg.Image = Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
                    end)
                    AvatarImg.Parent = Entry

                    local AvatarCorner = Instance.new("UICorner")
                    AvatarCorner.CornerRadius = UDim.new(0, 4)
                    AvatarCorner.Parent = AvatarImg

                    Entry.MouseButton1Click:Connect(function()
                        if SelectedTargets[player.Name] then
                            SelectedTargets[player.Name] = nil
                            Entry.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                        else
                            table.clear(SelectedTargets)
                            SelectedTargets[player.Name] = player
                            
                            for _, child in pairs(PlayerScrollFrame:GetChildren()) do
                                if child:IsA("TextButton") then
                                    child.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                                end
                            end
                            Entry.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
                        end
                        
                        SearchTextBox.Text = ""
                        SearchText = ""
                        SearchTextBox.Visible = false
                        UpdateStatus()
                    end)
                else
                    existingButton.BackgroundColor3 = SelectedTargets[player.Name] and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(50, 50, 50)
                end
            end
        end
    end
    
    for _, child in pairs(PlayerScrollFrame:GetChildren()) do
        if child:IsA("TextButton") and not currentPlayers[child.Name] then
            child:Destroy()
        end
    end
    
    PlayerScrollFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
end

