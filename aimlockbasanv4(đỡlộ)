--============================================================
-- BOT DETECTION
--============================================================
local function isBotModel(model)
    if not model or not model.Parent then return false end
    if not model:IsA("Model") then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    return true
end

local botCache = {}
local lastBotScan = 0

local function scanBots()
    local bots = {}
    local seen = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Parent then
            local model = obj.Parent
            if not seen[model] and isBotModel(model) then
                if obj.Health > 0 then
                    seen[model] = true
                    table.insert(bots, model)
                end
            end
        end
    end
    return bots
end

local function getBots()
    local now = tick()
    if now - lastBotScan >= Config.BotScanRate then
        lastBotScan = now
        botCache = scanBots()
        for model, _ in pairs(BlacklistBots) do
            if not model.Parent then
                BlacklistBots[model] = nil
            end
        end
    end
    return botCache
end

--============================================================
-- CHỌN VỊ TRÍ AIM (4 LỚP FALLBACK, HOẠT ĐỘNG CẢ Ở XA)
-- Trả về Vector3 thay vì BasePart để có thể offset lên đầu
--============================================================
local HEAD_NAMES = {
    "HeadHB", "Head", "head", "HeadHitbox", "HitboxHead",
    "HeadMesh", "HeadPart", "Head1", "Head_2",
    "Hat", "HatPart",
}

local function getAimPosition(character)
    if not character or not character.Parent then return nil end

    -- LỚP 1: tìm theo tên phổ biến (bao gồm cả trong Accessory/Hat)
    for _, name in ipairs(HEAD_NAMES) do
        local p = character:FindFirstChild(name, true)  -- true = tìm cả descendants
        if p and p:IsA("BasePart") then
            if DEBUG_AIM_PART then
                print("[AIM] L1 name =", p.Name, "dist =", (p.Position - camera.CFrame.Position).Magnitude)
            end
            return p.Position
        end
    end

    -- LỚP 2: tìm bất kỳ BasePart nào có "head" trong tên (case-insensitive)
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") and string.find(string.lower(obj.Name), "head") then
            if DEBUG_AIM_PART then
                print("[AIM] L2 contains 'head' =", obj.Name)
            end
            return obj.Position
        end
    end

    -- LỚP 3: tìm part CAO NHẤT trong character (đầu luôn là part cao nhất)
    -- Hoạt động cả khi Head bị stream out hoặc ẩn
    local highestPart = nil
    local highestY = -math.huge
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
            if obj.Position.Y > highestY then
                highestY = obj.Position.Y
                highestPart = obj
            end
        end
    end

    if highestPart then
        -- Offset thêm 0.5 stud lên để chắc chắn vào vùng đầu
        local aimPos = highestPart.Position + Vector3.new(0, 0.5, 0)
        if DEBUG_AIM_PART then
            print("[AIM] L3 highest part =", highestPart.Name, "pos =", aimPos)
        end
        return aimPos
    end

    -- LỚP 4: fallback cuối - Root + offset lên đầu (dựa vào Humanoid)
    local root = character:FindFirstChild("HumanoidRootPart")
    local hum = character:FindFirstChildOfClass("Humanoid")
    if root then
        -- HipHeight mặc định R15 là 2, R6 là 2. Cộng thêm 1.5 để lên đầu
        local headOffset = (hum and hum.HipHeight or 2) + 1.5
        local aimPos = root.Position + Vector3.new(0, headOffset, 0)
        if DEBUG_AIM_PART then
            print("[AIM] L4 root+offset =", aimPos)
        end
        return aimPos
    end

    -- Không tìm được gì -> bỏ qua mục tiêu (KHÔNG aim người)
    if DEBUG_AIM_PART then
        print("[AIM] FAILED - no part found for", character.Name)
    end
    return nil
end

--============================================================
-- AIM TARGET
--============================================================
local targetCache = {}
local lastTargetScan = 0

local function rebuildTargetCache()
    local all = {}

    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= localPlayer and v.Character and not BlacklistPlayers[v] then
            local hum = v.Character:FindFirstChildOfClass("Humanoid")
            local root = v.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                table.insert(all, {character = v.Character, root = root, isBot = false})
            end
        end
    end

    for _, model in ipairs(getBots()) do
        if not BlacklistBots[model] then
            local hum = model:FindFirstChildOfClass("Humanoid")
            local root = model:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                table.insert(all, {character = model, root = root, isBot = true})
            end
        end
    end

    targetCache = all
end

local function getBestAimPosition()
    local cam = workspace.CurrentCamera
    if not cam then return nil end

    local now = tick()
    if now - lastTargetScan >= Config.RetargetTime then
        lastTargetScan = now
        rebuildTargetCache()
    end

    local viewport = cam.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)

    local myRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    local originPos = myRoot and myRoot.Position or cam.CFrame.Position

    local bestPos, bestDist = nil, math.huge
    local bestDistToCenter = math.huge

    for _, t in ipairs(targetCache) do
        if t.root.Parent and t.character and t.character.Parent then
            local dist3D = (t.root.Position - originPos).Magnitude

            if dist3D <= Config.ESPRange then
                local aimPos = getAimPosition(t.character)
                if aimPos then
                    local sp, onScreen = cam:WorldToViewportPoint(aimPos)

                    if onScreen and sp.Z > 0 then
                        local distToCenter = (Vector2.new(sp.X, sp.Y) - center).Magnitude

                        if distToCenter <= Config.FOV then
                            local isCloser3D = dist3D < bestDist - DIST_EPSILON
                            local isSame3D   = math.abs(dist3D - bestDist) <= DIST_EPSILON

                            if isCloser3D then
                                bestDist = dist3D
                                bestDistToCenter = distToCenter
                                bestPos = aimPos
                            elseif isSame3D and distToCenter < bestDistToCenter then
                                bestDist = dist3D
                                bestDistToCenter = distToCenter
                                bestPos = aimPos
                            end
                        end
                    end
                end
            end
        end
    end

    return bestPos
end

