local function handleScriptKey(actionName, inputState, inputObject)
    if inputState == Enum.UserInputState.Begin then
        local key = inputObject.KeyCode

        if key == Enum.KeyCode.Q then
            AimbotEnabled = not AimbotEnabled
            updateAllUI()
        elseif key == Enum.KeyCode.B then
            espenabled = not espenabled
            if not espenabled then clearAllHighlights() end
            updateAllUI()
        elseif key == Enum.KeyCode.H then
            if Config.AimKey == Enum.UserInputType.MouseButton1 then
                Config.AimKey = Enum.UserInputType.MouseButton2
            else
                Config.AimKey = Enum.UserInputType.MouseButton1
            end
            updateAllUI()
            aiming = false
        elseif key == Enum.KeyCode.J then
            local model = getModelUnderMouse()
            if model then
                local plr = Players:GetPlayerFromCharacter(model)
                if plr then
                    if BlacklistPlayers[plr] then
                        BlacklistPlayers[plr] = nil
                    else
                        BlacklistPlayers[plr] = true
                        removeHighlightFor(model)
                        activeHighlights[model] = nil
                        if targetPart and targetPart:FindFirstAncestorOfClass("Model") == model then
                            targetPart = nil
                        end
                    end
                else
                    if BlacklistBots[model] then
                        BlacklistBots[model] = nil
                    else
                        BlacklistBots[model] = true
                        removeHighlightFor(model)
                        activeHighlights[model] = nil
                        if targetPart and targetPart:FindFirstAncestorOfClass("Model") == model then
                            targetPart = nil
                        end
                    end
                end
                if BlacklistPanel.Visible then refreshBlacklistUI() end
            end
        elseif key == Enum.KeyCode.L then
            BlacklistPanel.Visible = not BlacklistPanel.Visible
            if BlacklistPanel.Visible then refreshBlacklistUI() end
        end
    end

    if Main and Main.Visible then
        return Enum.ContextActionResult.Sink
    end
    return Enum.ContextActionResult.Pass
end

for _, key in ipairs({Enum.KeyCode.Q, Enum.KeyCode.B, Enum.KeyCode.H, Enum.KeyCode.J, Enum.KeyCode.L}) do
    ContextActionService:BindActionAtPriority(
        "ScriptKey_" .. key.Name,
        handleScriptKey,
        false,
        HIGH_PRIORITY,
        key
    )
end

