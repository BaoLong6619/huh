--============================================================
local function getModelUnderMouse()
    local mouse = UserInputService:GetMouseLocation()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local ray = cam:ViewportPointToRay(mouse.X, mouse.Y)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {}
    if localPlayer.Character then table.insert(ignore, localPlayer.Character) end
    params.FilterDescendantsInstances = ignore

    local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
    if not result then return nil end

    local model = result.Instance:FindFirstAncestorOfClass("Model")
    if not model then return nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    return model
end

--============================================================
-- AIM LOOP
--============================================================
RunService.RenderStepped:Connect(function()
    if not AimbotEnabled or not aiming then
        targetPart = nil
        return
    end

    local now = tick()
    if now - lastRetarget >= Config.RetargetTime then
        lastRetarget = now
        targetPart = getBestAimPosition()
    end

    if not targetPart then
        targetPart = getBestAimPosition()
        lastRetarget = now
    end

    if not targetPart then return end

    local cam = workspace.CurrentCamera
    if not cam then return end

    local screenPos, onScreen = cam:WorldToViewportPoint(targetPart)
    if not onScreen then return end

    local mouse = UserInputService:GetMouseLocation()
    local dx = screenPos.X - mouse.X
    local dy = screenPos.Y - mouse.Y

    local moveX = dx * Config.AimSpeed
    local moveY = dy * Config.AimSpeed

    if hasMouseMoveRel then
        mousemoverel(moveX, moveY)
    elseif hasMouseMoveAbs then
        mousemoveabs(mouse.X + moveX, mouse.Y + moveY)
    end
end)

