    end
    if uiRefs.refreshAimKey then
        uiRefs.refreshAimKey()
    end
end

local function createToggle(name, configKey)
    local btn = Instance.new("TextButton", Page)
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Text = "  " .. name
    btn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local ind = Instance.new("Frame", btn)
    ind.Size = UDim2.new(0, 36, 0, 18)
    ind.Position = UDim2.new(1, -46, 0.5, -9)
    ind.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    ind.BorderSizePixel = 0
    Instance.new("UICorner", ind).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", ind)
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new(0, 2, 0.5, -7)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local function refresh()
        local on = false
        if configKey == "espenabled" then on = espenabled
        elseif configKey == "AimbotEnabled" then on = AimbotEnabled
        elseif configKey == "PriorityPlayer" then on = Config.PriorityPlayer
        end
        ind.BackgroundColor3 = on and MainColor or Color3.fromRGB(60, 60, 70)
        knob.Position = on and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    end

    table.insert(uiRefs.toggles, {key = configKey, refresh = refresh})
    refresh()

    btn.MouseButton1Click:Connect(function()
        if configKey == "espenabled" then
            espenabled = not espenabled
            if not espenabled then clearAllHighlights() end
        elseif configKey == "AimbotEnabled" then
            AimbotEnabled = not AimbotEnabled
        elseif configKey == "PriorityPlayer" then
            Config.PriorityPlayer = not Config.PriorityPlayer
        end
        refresh()
    end)
    return btn
