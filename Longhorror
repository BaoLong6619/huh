-- Hàm hỗ trợ làm đẹp
local function MakeGuiBeautiful(obj, cornerRadius, strokeColor, strokeThickness)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = cornerRadius or UDim.new(0, 15)
    corner.Parent = obj
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = strokeColor or Color3.fromRGB(0, 255, 150)
    stroke.Thickness = strokeThickness or 2
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = obj
    return stroke
end

