local function AddToggle(text, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0, 300, 0, 50)
    Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Btn.Text = text
    Btn.TextColor3 = Color3.fromRGB(150, 150, 150)
    Btn.Font = Enum.Font.GothamBold
    Btn.TextSize = 14
    Btn.AutoButtonColor = false
    Btn.Parent = Container

    local stroke = MakeGuiBeautiful(Btn, UDim.new(0, 12), Color3.fromRGB(60, 60, 60), 1.5)
    
    local state = false
    Btn.MouseButton1Click:Connect(function()
        state = not state
        callback(state)
        
        local color = state and Color3.fromRGB(0, 255, 127) or Color3.fromRGB(150, 150, 150)
        local strokeColor = state and Color3.fromRGB(0, 255, 127) or Color3.fromRGB(60, 60, 60)
        
        TweenService:Create(Btn, TweenInfo.new(0.3), {TextColor3 = color}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.3), {Color = strokeColor, Thickness = state and 2.5 or 1.5}):Play()
    end)
end

AddToggle("⚡ FULLBRIGHT (NHÌN ĐÊM)", ToggleFB)
AddToggle("⏱️ INSTANT PROMPT (KO DELAY)", ToggleInstant)
