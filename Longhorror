-- 1. Booster (Tự chạy - Đã tối ưu quét cục bộ)
local function Boost()
    settings().Rendering.QualityLevel = 1
    for _, v in pairs(Lighting:GetChildren()) do
        if v:IsA("PostProcessEffect") or v:IsA("BlurEffect") then v.Enabled = false end
    end
end
Boost()

-- 2. Fullbright
local FB_On = false
local function ToggleFB(s)
    FB_On = s
    if s then
        Lighting.Brightness = 2.5
        Lighting.ClockTime = 14
        Lighting.Ambient = Color3.new(1,1,1)
    else
        Lighting.Brightness = 1
        Lighting.Ambient = Color3.new(0,0,0)
    end
end

-- 3. Instant Prompt
local InstantConn
local function ToggleInstant(s)
    if s then
        InstantConn = ProximityService.PromptButtonHoldBegan:Connect(function(p) fireproximityprompt(p) end)
    else
        if InstantConn then InstantConn:Disconnect() end
    end
end

-- 4. ESP Player & Entity - 1000m (ĐÃ KHỬ LAG TUYỆT ĐỐI)
local ESP_Active = false
task.spawn(function()
    while task.wait(1) do
        if not ESP_Active then
            -- Chỉ xóa các ESP đang có trong workspace thay vì quét toàn game
            for _, obj in pairs(workspace:GetChildren()) do
                local esp = obj:FindFirstChild("LB_ESP")
                if esp then esp:Destroy() end
            end
            continue
        end
        
        -- QUẾT TỐI ƯU: Chỉ tìm trong danh sách con của Workspace (Không lag máy)
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") and obj ~= LocalPlayer.Character then
                -- Nếu đã gắn ESP rồi thì bỏ qua luôn, tránh giật đè
                if obj:FindFirstChild("LB_ESP") then continue end
                
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (obj.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                    if dist <= 1000 then
                        local isPlayer = Players:GetPlayerFromCharacter(obj)
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "LB_ESP"
                        highlight.FillTransparency = 0.5
                        highlight.OutlineTransparency = 0
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        
                        if isPlayer then
                            highlight.FillColor = Color3.fromRGB(0, 255, 0) -- Xanh lá cho người
                            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        else
                            highlight.FillColor = Color3.fromRGB(255, 0, 0) -- Đỏ cho quái
                            highlight.OutlineColor = Color3.fromRGB(255, 255,  yellow)
                            highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
                        end
                        highlight.Parent = obj
                    end
                end
            end
        end
    end
end)

