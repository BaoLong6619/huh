BringToggle.TextSize = 18
BringToggle.Font = Enum.Font.SourceSansBold
BringToggle.Text = "Silent Bring: TẮT ❌"
BringToggle.ZIndex = 6
BringToggle.Parent = MainFrame

local isBringing = false
BringToggle.MouseButton1Click:Connect(function()
    isBringing = not isBringing
    if isBringing then
        BringToggle.BackgroundColor3 = Color3.fromRGB(40, 150, 40)
        BringToggle.Text = "Silent Bring: BẬT ⚡"
    else
        BringToggle.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
        BringToggle.Text = "Silent Bring: TẮT ❌"
    end
end)

-- Vòng lặp quét danh sách liên tục bằng Heartbeat và giữ mục tiêu ổn định
RunService.Heartbeat:Connect(function()
    if isBringing and NameBox.Text ~= "" then
        local targetName = NameBox.Text:lower()
        local dist = tonumber(DistBox.Text) or 3
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and (p.Name:lower():find(targetName) or p.DisplayName:lower():find(targetName)) then
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    p.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -dist)
                end
            end
        end
    end
end)
