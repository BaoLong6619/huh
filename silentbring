-- 3. Công tắc Silent Bring (Dạng Toggle dùng lâu dài)
local BringToggle = Instance.new("TextButton")
BringToggle.Size = UDim2.new(0.9, 0, 0, 45)
BringToggle.Position = UDim2.new(0.05, 0, 0.65, 0)
BringToggle.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
