--============================================================
-- BOT DETECTION
--============================================================
local function isBotModel(model)
    if not model or not model.Parent then return false end
    if not model:IsA("Model") then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    return true
end

local botCache = {}
local lastBotScan = 0

local function scanBots()
    local bots = {}
    local seen = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Parent then
            local model = obj.Parent
            if not seen[model] and isBotModel(model) then
                if obj.Health > 0 then
                    seen[model] = true
                    table.insert(bots, model)
                end
            end
        end
    end
    return bots
end

local function getBots()
    local now = tick()
    if now - lastBotScan >= Config.BotScanRate then
        lastBotScan = now
        botCache = scanBots()
    end
    return botCache
end

--============================================================
-- AIM TARGET (FOV)
--============================================================
local targetCache = {}
local lastTargetScan = 0

local function rebuildTargetCache()
    local all = {}

    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= localPlayer and v.Character then
            local hum = v.Character:FindFirstChildOfClass("Humanoid")
            local root = v.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                local part = v.Character:FindFirstChild("HeadHB")
                    or v.Character:FindFirstChild("Head")
                    or v.Character:FindFirstChild("UpperTorso")
                    or root
                if part then
                    table.insert(all, {part = part, root = root, isBot = false})
                end
            end
        end
    end

    for _, model in ipairs(getBots()) do
        local hum = model:FindFirstChildOfClass("Humanoid")
        local root = model:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and root then
            local part = model:FindFirstChild("HeadHB")
                or model:FindFirstChild("Head")
                or model:FindFirstChild("UpperTorso")
                or root
            if part then
                table.insert(all, {part = part, root = root, isBot = true})
            end
        end
    end

    targetCache = all
end

local function getBestTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil end

    local now = tick()
    if now - lastTargetScan >= Config.RetargetTime then
        lastTargetScan = now
        rebuildTargetCache()
    end

    local viewport = cam.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)

    local bestPart, bestDist = nil, math.huge

    for _, t in ipairs(targetCache) do
        if t.part.Parent and t.root.Parent then
            local sp, onScreen = cam:WorldToViewportPoint(t.part.Position)
            if onScreen and sp.Z > 0 then
                local distToCenter = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if distToCenter <= Config.FOV then
                    local weight = 1
                    if Config.PriorityPlayer and t.isBot then
                        weight = 1.5
                    end
                    local weighted = distToCenter * weight
                    if weighted < bestDist then
                        bestDist = weighted
                        bestPart = t.part
                    end
                end
            end
        end
    end

    return bestPart
end

--============================================================
-- AIM LOOP
--============================================================
RunService.RenderStepped:Connect(function()
    if not AimbotEnabled or not aiming then
        targetPart = nil
        return
    end

    local now = tick()
    if now - lastRetarget >= Config.RetargetTime then
        lastRetarget = now
        targetPart = getBestTarget()
    end

    if not targetPart or not targetPart.Parent then
        targetPart = getBestTarget()
        lastRetarget = now
    end

    if not targetPart or not targetPart.Parent then return end

    local cam = workspace.CurrentCamera
    if not cam then return end

    local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
    if not onScreen then return end

    local mouse = UserInputService:GetMouseLocation()
    local dx = screenPos.X - mouse.X
    local dy = screenPos.Y - mouse.Y

    local moveX = dx * Config.AimSpeed
    local moveY = dy * Config.AimSpeed

    if hasMouseMoveRel then
        mousemoverel(moveX, moveY)
    elseif hasMouseMoveAbs then
        mousemoveabs(mouse.X + moveX, mouse.Y + moveY)
    end
end)

