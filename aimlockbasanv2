--============================================================
-- XỬ LÝ Q / B / H
-- - Menu MỞ  → Sink (chặn game)
-- - Menu ĐÓNG → Pass (trả phím cho game)
--============================================================
local function handleScriptKey(actionName, inputState, inputObject)
    if inputState == Enum.UserInputState.Begin then
        local key = inputObject.KeyCode

        if key == Enum.KeyCode.Q then
            AimbotEnabled = not AimbotEnabled
            updateAllUI()
        elseif key == Enum.KeyCode.B then
            espenabled = not espenabled
            if not espenabled then clearAllHighlights() end
            updateAllUI()
        elseif key == Enum.KeyCode.H then
            if Config.AimKey == Enum.UserInputType.MouseButton1 then
                Config.AimKey = Enum.UserInputType.MouseButton2
            else
                Config.AimKey = Enum.UserInputType.MouseButton1
            end
            updateAllUI()
            aiming = false
        end
    end

    if Main and Main.Visible then
        return Enum.ContextActionResult.Sink
    end
    return Enum.ContextActionResult.Pass
end

for _, key in ipairs({Enum.KeyCode.Q, Enum.KeyCode.B, Enum.KeyCode.H}) do
    ContextActionService:BindActionAtPriority(
        "ScriptKey_" .. key.Name,
        handleScriptKey,
        false,
        HIGH_PRIORITY,
        key
    )
end

--============================================================
-- RIÊNG PHÍM T: LUÔN PASS (không bao giờ bị chặn)
--============================================================
local function handleMenuKey(actionName, inputState, inputObject)
    if inputState == Enum.UserInputState.Begin then
        setMenuVisible(not Main.Visible)
    end
    -- Luôn Pass → T không bao giờ bị chặn khỏi game
    return Enum.ContextActionResult.Pass
end

ContextActionService:BindActionAtPriority(
    "ScriptKey_T",
    handleMenuKey,
    false,
    HIGH_PRIORITY,
    Enum.KeyCode.T
)

