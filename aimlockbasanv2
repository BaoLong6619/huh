-- ESP
--============================================================
local activeHighlights = {}

local function createHighlight(model, isBot)
    local tag = isBot and "BotHighlight" or "PlayerHighlight"
    local existing = model:FindFirstChild(tag)
    if existing then return existing end

    local hl = Instance.new("Highlight")
    hl.Name = tag
    hl.FillColor = isBot and BOT_FILL or PLAYER_FILL
    hl.OutlineColor = isBot and BOT_OUTLINE or PLAYER_OUTLINE
    hl.FillTransparency = FILL_TRANSPARENCY
    hl.OutlineTransparency = OUTLINE_TRANSPARENCY
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = model
    hl.Parent = model
    return hl
end

local function removeHighlightFor(model)
    for _, tag in ipairs({"PlayerHighlight", "BotHighlight"}) do
        local h = model:FindFirstChild(tag)
        if h then h:Destroy() end
    end
end

local function clearAllHighlights()
    for model, _ in pairs(activeHighlights) do
        if model and model.Parent then
            removeHighlightFor(model)
        end
    end
    activeHighlights = {}
end

local function updateESP()
    if not espenabled then
        if next(activeHighlights) ~= nil then
            clearAllHighlights()
        end
        return
    end

    local cam = workspace.CurrentCamera
    if not cam then return end
    local origin = cam.CFrame.Position
    local range = Config.ESPRange

    local visible = {}

    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= localPlayer and v.Character then
            local root = v.Character:FindFirstChild("HumanoidRootPart")
            local hum = v.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                if (root.Position - origin).Magnitude <= range then
                    visible[v.Character] = false
                end
            end
        end
    end

    for _, model in ipairs(getBots()) do
        local root = model:FindFirstChild("HumanoidRootPart")
        if root then
            if (root.Position - origin).Magnitude <= range then
                visible[model] = true
            end
        end
    end

    for model, _ in pairs(activeHighlights) do
        if not visible[model] or not model.Parent then
            removeHighlightFor(model)
            activeHighlights[model] = nil
        end
    end

    for model, isBot in pairs(visible) do
        if not activeHighlights[model] then
            local hl = createHighlight(model, isBot)
            activeHighlights[model] = hl
        end
    end
end

local espAccum = 0
RunService.Heartbeat:Connect(function(dt)
    espAccum += dt
    if espAccum < Config.ESPUpdateRate then return end
    espAccum = 0
    updateESP()
end)

