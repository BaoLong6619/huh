  // ==========================================
  // CONFIG
  // ==========================================
  const STOP_LINES = 7;   // <= auto dừng khi còn 7 dòng nữa là hết code
  const CHUNK = 80;       // số ký tự mỗi tick
  const TICK_MS = 6;      // khoảng nghỉ giữa các tick

  let codeIndex = 0;
  let mode = 'code';
  let autoTyping = false;
  let autoTimer = null;
  let freeEl = null;
