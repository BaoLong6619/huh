-- 3. HÀM XỬ LÝ KHI CÓ ANIMATION PHÁT
local function onAnimationPlayed(animationTrack)
    if not isScanning then return end
    
    local anim = animationTrack.Animation
    if not anim then return end
    
    local fullId = tostring(anim.AnimationId)
    local extractedId = string.match(fullId, "%d+") or "?"
    
    -- Nếu đã ghi nhận ID này rồi thì bỏ qua
    if loggedIds[extractedId] then return end
    loggedIds[extractedId] = true
    
    local animName = anim.Name or "NoName"
    
    -- Hiện lên bảng
    local TextBtn = Instance.new("TextButton")
    TextBtn.Size = UDim2.new(1, 0, 0, 40)
    TextBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    TextBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    TextBtn.Font = Enum.Font.Code
    TextBtn.TextSize = 12
    TextBtn.Text = string.format("Tên: %s\nID: %s", animName, extractedId)
    TextBtn.TextXAlignment = Enum.TextXAlignment.Left
    TextBtn.Parent = Scroll
    
    -- Click để copy ID
    TextBtn.MouseButton1Click:Connect(function()
        if setclipboard then
            setclipboard(extractedId)
            Title.Text = " Đã Copy ID: " .. extractedId
            Title.TextColor3 = Color3.fromRGB(0, 255, 0)
            task.delay(2, function()
                if Title and Title.Parent then
                    Title.Text = " HOÀN TẤT! (Bấm ID để Copy)"
                    Title.TextColor3 = Color3.fromRGB(0, 255, 150)
                end
            end)
        end
    end)
    
    print("🔥 ANIM: " .. animName .. " | ID: " .. extractedId)
end

-- 4. THIẾT LẬP QUÉT CẢ NHÂN VẬT VÀ VŨ KHÍ
local function setupAllAnimators()
    local char = player.Character
    if not char then return end
    
    -- Quét Animator của nhân vật
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if animator then
            animator.AnimationPlayed:Connect(onAnimationPlayed)
        end
    end
    
    -- Quét Animator của Tool (vũ khí) đang cầm
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Tool") then
            local toolAnimator = obj:FindFirstChildOfClass("Animator")
            if not toolAnimator then
                local handle = obj:FindFirstChild("Handle")
                if handle then
                    toolAnimator = handle:FindFirstChildOfClass("Animator")
                end
            end
            
            if toolAnimator then
                toolAnimator.AnimationPlayed:Connect(onAnimationPlayed)
            end
        end
    end
end

-- Chạy ngay nếu đã có nhân vật
if player.Character then
    setupAllAnimators()
end

-- Tự động setup lại nếu chết/respawn
player.CharacterAdded:Connect(function()
    task.wait(1)
    setupAllAnimators()
end)

