local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local VirtualUser = game:GetService("VirtualUser")
local player = Players.LocalPlayer

-- TỔNG HỢP TẤT CẢ ID (CŨ + MỚI)
local targetAnimationIds = {
    -- Đòn cũ (Tay không)
    ["13532562418"] = true,
    ["13532600125"] = true,
    ["13532604085"] = true,
    
    -- Đòn mới (Vũ khí - từ ảnh bạn gửi)
    ["123005629431309"] = true,
    ["100059874351664"] = true,
    ["104895379416342"] = true,
    ["134775406437626"] = true
}

-- CẤU HÌNH CHUNG
local COMBO_REQUIRED = 3
local COMBO_TIMEOUT  = 1.5
local JUMP_DELAY     = 0.5 

-- BIẾN TRẠNG THÁI
local comboCount = 0
local lastM1Time = 0
local busy = false           
local isEnabled = false 
local currentMode = "C" -- "C" (Đợi) hoặc "V" (Nhảy ngay)

-- Hàm giả lập bấm chuột trái (M1)
local function simulateClick()
    VirtualUser:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    task.wait(0.05)
    VirtualUser:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end

-- Hàm nhảy
local function executeFakeJump(character, humanoid)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 50, hrp.AssemblyLinearVelocity.Z)
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end

local function onAnimationPlayed(animationTrack)
    if not isEnabled then return end
    if busy then return end

    local animId = tostring(animationTrack.Animation.AnimationId)
    local extractedId = string.match(animId, "%d+")

    -- Kiểm tra xem animation có nằm trong danh sách 7 ID không
    if not targetAnimationIds[extractedId] then return end

    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local now = tick()
    -- Reset combo nếu đứng yên quá lâu
    if now - lastM1Time > COMBO_TIMEOUT then
        comboCount = 0
    end

    comboCount = comboCount + 1
    lastM1Time = now

    -- Đánh đủ 3 đòn
    if comboCount >= COMBO_REQUIRED then
        busy = true
        comboCount = 0
        lastM1Time = 0

        -- CHẾ ĐỘ V (Nhảy ngay -> Đấm)
        if currentMode == "V" then
            if character.Parent and humanoid.Health > 0 then
                executeFakeJump(character, humanoid)
                task.wait(0.1) 
                simulateClick()
            end
        end
        
        -- CHẾ ĐỘ C (Đợi 0.5s -> Nhảy -> Đấm)
        if currentMode == "C" then
            task.wait(JUMP_DELAY)
            if character.Parent and humanoid.Health > 0 then
                executeFakeJump(character, humanoid)
                task.wait(0.1) 
                simulateClick()
            end
        end

        busy = false
    end
end

local function setupCharacter(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if humanoid then
        local animator = humanoid:WaitForChild("Animator", 5)
        if animator then
            animator.AnimationPlayed:Connect(onAnimationPlayed)
        end
    end
end

if player.Character then setupCharacter(player.Character) end
player.CharacterAdded:Connect(setupCharacter)

-- PHÍM TẮT: E (Bật/Tắt) và R (Chuyển C <-> V)
UserInputService.InputBegan:Connect(function(input, isProcessed)
    if isProcessed then return end
    
    -- BẤM PHÍM E: Bật/Tắt
    if input.KeyCode == Enum.KeyCode.E then
        isEnabled = not isEnabled
        comboCount = 0
        busy = false
    end
    
    -- BẤM PHÍM R: Đổi chế độ C <-> V
    if input.KeyCode == Enum.KeyCode.R then
        if currentMode == "C" then
            currentMode = "V"
        else
            currentMode = "C"
        end
        comboCount = 0
        busy = false
    end
end)
