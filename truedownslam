local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local VirtualUser = game:GetService("VirtualUser")
local player = Players.LocalPlayer

-- TOÀN BỘ ID ANIMATION
local targetAnimationIds = {
    ["13532562418"] = true, ["13532600125"] = true, ["13532604085"] = true,
    ["123005629431309"] = true, ["100059874351664"] = true, ["104895379416342"] = true, ["134775406437626"] = true,
    ["13370310513"] = true, ["13390230973"] = true, ["13378751717"] = true, ["13378708199"] = true,
    ["14004222985"] = true, ["13997092940"] = true, ["14001963401"] = true, ["14136436157"] = true,
    ["15259161390"] = true, ["15240216931"] = true, ["15240176873"] = true, ["15162694192"] = true,
    ["13491635433"] = true, ["13296577783"] = true, ["13295919399"] = true, ["13295936866"] = true
}

local COMBO_REQUIRED = 3
local COMBO_TIMEOUT  = 1.5

local comboCount = 0
local lastM1Time = 0
local isEnabled = false
local busy = false

-- MẶC ĐỊNH BAN ĐẦU LÀ V
local currentMode = "V" 

-- Hàm giả lập bấm chuột trái
local function simulateClick()
    VirtualUser:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    task.wait(0.01)
    VirtualUser:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end

-- Hàm nhảy
local function executeFakeJump(character, humanoid)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 50, hrp.AssemblyLinearVelocity.Z)
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end

local function onAnimationPlayed(animationTrack)
    if not isEnabled or busy then return end

    local animId = tostring(animationTrack.Animation.AnimationId)
    local extractedId = string.match(animId, "%d+")

    if not targetAnimationIds[extractedId] then return end

    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local now = tick()
    if now - lastM1Time > COMBO_TIMEOUT then
        comboCount = 0
    end

    comboCount = comboCount + 1
    lastM1Time = now

    -- ĐÁNH ĐỦ 3 ĐÒN
    if comboCount >= COMBO_REQUIRED then
        busy = true
        comboCount = 0
        lastM1Time = 0

        if character.Parent and humanoid.Health > 0 then
            -- Nếu là chế độ C thì đợi 0.5s, chế độ V thì nhảy luôn
            if currentMode == "C" then
                task.wait(0.5)
            end

            -- Nhảy lên
            executeFakeJump(character, humanoid)
            
            -- Đợi 0.1s để bay lên
            task.wait(0.1)
            
            -- Tự động đấm phát thứ 4
            simulateClick()
            
            -- Chạy xong 1 lần thì tự tắt
            task.wait(0.3) 
            isEnabled = false
        end

        busy = false
    end
end

local function setupCharacter(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if humanoid then
        local animator = humanoid:WaitForChild("Animator", 5)
        if animator then
            animator.AnimationPlayed:Connect(onAnimationPlayed)
        end
    end
end

if player.Character then setupCharacter(player.Character) end
player.CharacterAdded:Connect(setupCharacter)

-- PHÍM TẮT
UserInputService.InputBegan:Connect(function(input, isProcessed)
    if isProcessed then return end
    
    -- BẤM E: Bật (Chạy 1 lần)
    if input.KeyCode == Enum.KeyCode.E then
        isEnabled = true
        comboCount = 0
        busy = false
    end
    
    -- BẤM R: Đổi V <-> C
    if input.KeyCode == Enum.KeyCode.R then
        if currentMode == "V" then
            currentMode = "C"
        else
            currentMode = "V"
        end
    end
end)
