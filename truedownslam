local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local VirtualUser = game:GetService("VirtualUser")
local player = Players.LocalPlayer

-- ID 3 đòn đấm thường
local targetAnimationIds = {
    ["13532562418"] = true,
    ["13532600125"] = true,
    ["13532604085"] = true
}

-- CẤU HÌNH CHUNG
local COMBO_REQUIRED = 3
local COMBO_TIMEOUT  = 1.5

-- CẤU HÌNH CHO TÍNH NĂNG C
local JUMP_DELAY     = 0.5  -- Đợi 0.5s trước khi nhảy

-- BIẾN TRẠNG THÁI
local comboCount = 0
local lastM1Time = 0
local busy = false           

-- Mặc định cả 2 đều TẮT
local enabledV = false  
local enabledC = false  

-- Hàm giả lập bấm chuột trái (M1)
local function simulateClick()
    VirtualUser:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    task.wait(0.05)
    VirtualUser:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end

-- Hàm nhảy
local function executeFakeJump(character, humanoid)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 50, hrp.AssemblyLinearVelocity.Z)
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end

local function onAnimationPlayed(animationTrack)
    if not enabledV and not enabledC then return end
    if busy then return end

    local animId = tostring(animationTrack.Animation.AnimationId)
    local extractedId = string.match(animId, "%d+")

    if not targetAnimationIds[extractedId] then return end

    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local now = tick()
    if now - lastM1Time > COMBO_TIMEOUT then
        comboCount = 0
    end

    comboCount = comboCount + 1
    lastM1Time = now

    -- Đánh đủ 3 đòn
    if comboCount >= COMBO_REQUIRED then
        busy = true
        comboCount = 0
        lastM1Time = 0

        -- KÍCH HOẠT TÍNH NĂNG V (Nhảy ngay -> Đấm)
        if enabledV then
            if character.Parent and humanoid.Health > 0 then
                executeFakeJump(character, humanoid)
                task.wait(0.1) 
                simulateClick()
            end
        end
        
        -- KÍCH HOẠT TÍNH NĂNG C (Đợi 0.5s -> Nhảy -> Đấm)
        if enabledC then
            task.wait(JUMP_DELAY)
            if character.Parent and humanoid.Health > 0 then
                executeFakeJump(character, humanoid)
                task.wait(0.1) 
                simulateClick()
            end
        end

        busy = false
    end
end

local function setupCharacter(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if humanoid then
        local animator = humanoid:WaitForChild("Animator", 5)
        if animator then
            animator.AnimationPlayed:Connect(onAnimationPlayed)
        end
    end
end

if player.Character then setupCharacter(player.Character) end
player.CharacterAdded:Connect(setupCharacter)

-- PHÍM TẮT: V và C
UserInputService.InputBegan:Connect(function(input, isProcessed)
    if isProcessed then return end
    
    -- BẤM PHÍM V
    if input.KeyCode == Enum.KeyCode.V then
        enabledV = not enabledV
        if enabledV then enabledC = false end -- Tắt C nếu bật V
        
        comboCount = 0
        busy = false
    end
    
    -- BẤM PHÍM C
    if input.KeyCode == Enum.KeyCode.C then
        enabledC = not enabledC
        if enabledC then enabledV = false end -- Tắt V nếu bật C
        
        comboCount = 0
        busy = false
    end
end)
