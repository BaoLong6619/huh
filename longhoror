-- ==================== CHAMS TỐI ƯU ====================
local ChamsActive = false
local ChamsList = {}
local Connections = {}

local COLOR_PLAYER = Color3.fromRGB(0, 255, 0)
local COLOR_MONSTER = Color3.fromRGB(255, 0, 0)
local COLOR_WHITE = Color3.fromRGB(255, 255, 255)

-- 1 Highlight cho cả model (nhẹ hơn nhiều so với từng part)
local function AddChams(model)
    if ChamsList[model] then return end
    ChamsList[model] = true
    
    local isPlayer = Players:GetPlayerFromCharacter(model)
    local color = isPlayer and COLOR_PLAYER or COLOR_MONSTER
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "LB_Chams"
    highlight.FillColor = color
    highlight.FillTransparency = 0.4
    highlight.OutlineColor = COLOR_WHITE
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = model
end

local function RemoveChams(model)
    ChamsList[model] = nil
    local highlight = model:FindFirstChild("LB_Chams")
    if highlight then highlight:Destroy() end
end

local function ClearAllChams()
    for model, _ in pairs(ChamsList) do
        local highlight = model:FindFirstChild("LB_Chams")
        if highlight then highlight:Destroy() end
    end
    ChamsList = {}
end

local function IsValidTarget(model)
    if not model:IsA("Model") then return false end
    if model == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(model) then return true end
    if model:FindFirstChild("Humanoid") and model:FindFirstChild("HumanoidRootPart") then
        return true
    end
    return false
end

local function WatchPlayers()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            AddChams(player.Character)
        end
    end
    
    local conn1 = Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function(char)
            task.wait(0.3)
            if ChamsActive then AddChams(char) end
        end)
    end)
    table.insert(Connections, conn1)
    
    local conn2 = Players.PlayerRemoving:Connect(function(player)
        if player.Character then RemoveChams(player.Character) end
    end)
    table.insert(Connections, conn2)
end

local function WatchMonsters()
    for _, model in pairs(Workspace:GetDescendants()) do
        if IsValidTarget(model) then
            AddChams(model)
        end
    end
    
    local conn = Workspace.DescendantAdded:Connect(function(descendant)
        if ChamsActive and descendant:IsA("Model") then
            task.delay(0.2, function()
                if descendant.Parent and IsValidTarget(descendant) then
                    AddChams(descendant)
                end
            end)
        end
    end)
    table.insert(Connections, conn)
end

local function ToggleChams(state)
    ChamsActive = state
    if state then
        for _, conn in pairs(Connections) do conn:Disconnect() end
        Connections = {}
        WatchPlayers()
        WatchMonsters()
    else
        for _, conn in pairs(Connections) do conn:Disconnect() end
        Connections = {}
        ClearAllChams()
    end
end

-- ==================== TOGGLE CÓ HIỆU ỨNG ====================
local function AddToggle(text, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0, 300, 0, 50)
    Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Btn.Text = text
    Btn.TextColor3 = Color3.fromRGB(150, 150, 150)
    Btn.Font = Enum.Font.GothamBold
    Btn.TextSize = 14
    Btn.AutoButtonColor = false
    Btn.Parent = Container

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 12)
    BtnCorner.Parent = Btn

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Color = Color3.fromRGB(60, 60, 60)
    BtnStroke.Thickness = 1.5
    BtnStroke.Parent = Btn
    
    local state = false
    local isHovering = false
    
    local function UpdateAppearance()
        if state then
            if isHovering then
                TweenService:Create(Btn, TweenInfo.new(0.2), {
                    BackgroundColor3 = Color3.fromRGB(20, 50, 35),
                    TextColor3 = Color3.fromRGB(255, 255, 255)
                }):Play()
                TweenService:Create(BtnStroke, TweenInfo.new(0.2), {
                    Color = Color3.fromRGB(0, 255, 200),
                    Thickness = 3
                }):Play()
            else
                TweenService:Create(Btn, TweenInfo.new(0.2), {
                    BackgroundColor3 = Color3.fromRGB(30, 30, 30),
                    TextColor3 = Color3.fromRGB(0, 255, 127)
                }):Play()
                TweenService:Create(BtnStroke, TweenInfo.new(0.2), {
                    Color = Color3.fromRGB(0, 255, 127),
                    Thickness = 2.5
                }):Play()
            end
        else
            if isHovering then
                TweenService:Create(Btn, TweenInfo.new(0.2), {
                    BackgroundColor3 = Color3.fromRGB(50, 50, 50),
                    TextColor3 = Color3.fromRGB(255, 255, 255)
                }):Play()
                TweenService:Create(BtnStroke, TweenInfo.new(0.2), {
                    Color = Color3.fromRGB(180, 180, 180),
                    Thickness = 2
                }):Play()
            else
                TweenService:Create(Btn, TweenInfo.new(0.2), {
                    BackgroundColor3 = Color3.fromRGB(30, 30, 30),
                    TextColor3 = Color3.fromRGB(150, 150, 150)
                }):Play()
                TweenService:Create(BtnStroke, TweenInfo.new(0.2), {
                    Color = Color3.fromRGB(60, 60, 60),
                    Thickness = 1.5
                }):Play()
            end
        end
    end
    
    Btn.MouseEnter:Connect(function()
        isHovering = true
        UpdateAppearance()
    end)
    
    Btn.MouseLeave:Connect(function()
        isHovering = false
        UpdateAppearance()
    end)
    
    Btn.MouseButton1Click:Connect(function()
        state = not state
        callback(state)
        UpdateAppearance()
    end)
end

