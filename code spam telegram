(function () {
  document.getElementById('tg-final-panel')?.remove();
  document.getElementById('tg-final-style')?.remove();

  const style = document.createElement('style');
  style.id = 'tg-final-style';
  style.innerHTML = `
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');
    
    #tg-final-panel {
      position: fixed; top: 20px; right: 20px; z-index: 999999;
      width: 260px; padding: 16px;
      background: rgba(15, 15, 20, 0.95);
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      color: #fff; font-family: 'Inter', sans-serif;
      border-radius: 12px; border: 1px solid rgba(0, 210, 255, 0.3);
      box-shadow: 0 10px 30px rgba(0, 210, 255, 0.15);
      display: flex; flex-direction: column; gap: 12px;
      transition: opacity 0.3s, transform 0.3s;
    }
    
    /* Class ẩn menu */
    #tg-final-panel.hidden-panel {
      opacity: 0;
      pointer-events: none;
      transform: scale(0.9);
    }

    #tg-final-panel.minimized {
      width: 48px; height: 48px; padding: 0; border-radius: 50%;
      align-items: center; justify-content: center; cursor: pointer;
      background: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
      border-color: transparent; box-shadow: 0 0 20px rgba(0, 210, 255, 0.6);
    }
    #tg-final-panel.minimized > *:not(.toggle-btn) { display: none; }
    #tg-final-panel.minimized .toggle-btn, #tg-final-panel.minimized .close-btn { display: none; }
    #tg-final-panel.minimized::after { content: '⚡'; font-size: 22px; }

    #tg-final-panel textarea {
      width: 100%; box-sizing: border-box; padding: 10px;
      background: rgba(0, 0, 0, 0.5); border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px; color: #fff; font-family: 'Inter', sans-serif;
      resize: none; outline: none; font-size: 13px;
    }
    #tg-final-panel textarea:focus { border-color: #00d2ff; }

    #tg-final-panel .input-group {
      display: flex; align-items: center; background: rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 0 10px;
    }
    #tg-final-panel .input-group:focus-within { border-color: #00d2ff; }
    #tg-final-panel .input-group label { font-size: 12px; color: #888; white-space: nowrap; }
    #tg-final-panel input[type=number] {
      width: 100%; padding: 10px 0; background: transparent; border: none;
      color: #00d2ff; outline: none; font-family: 'Inter', sans-serif; text-align: right; font-weight: bold;
    }

    #tg-final-panel button {
      width: 100%; padding: 12px; border: none; border-radius: 8px;
      background: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
      color: #fff; font-weight: 600; font-size: 14px; cursor: pointer; transition: 0.2s;
    }
    #tg-final-panel button:hover { box-shadow: 0 6px 20px rgba(0, 210, 255, 0.4); }
    #tg-final-panel button.stop { background: linear-gradient(135deg, #ff4757 0%, #c0392b 100%); }
    
    #tg-final-panel .controls { position: absolute; top: 12px; right: 12px; display: flex; gap: 6px; }
    #tg-final-panel .ctrl-btn {
      width: 24px; height: 24px; background: rgba(255, 255, 255, 0.1); color: #aaa; border-radius: 6px;
      display: flex; align-items: center; justify-content: center; font-size: 14px; cursor: pointer;
    }
    #tg-final-panel .ctrl-btn:hover { background: rgba(255, 255, 255, 0.2); color: #fff; }
    #tg-final-panel .close-btn:hover { background: #ff4757; color: #fff; }
    #tg-final-panel.minimized .ctrl-btn { display: none; }
  `;
  document.head.appendChild(style);

  const panel = document.createElement('div');
  panel.id = 'tg-final-panel';
  // Thêm class ẩn mặc định khi mới tạo
  panel.className = 'hidden-panel'; 
  panel.innerHTML = `
    <div class="controls">
      <div class="ctrl-btn" id="final-toggle">−</div>
      <div class="ctrl-btn close-btn" id="final-close">✕</div>
    </div>
    <textarea id="final-msg" rows="2" placeholder="Nhập nội dung...">Hello</textarea>
    <div class="input-group">
      <label>Delay (ms)</label>
      <!-- Đã đổi mặc định thành 50 -->
      <input type="number" id="final-delay" value="50" min="10">
    </div>
    <button id="final-btn">Spam</button>
  `;
  document.body.appendChild(panel);

  // ================= PHÍM TẮT I + O + P =================
  let keysPressed = {};
  document.addEventListener('keydown', (e) => {
    // Bỏ qua nếu đang gõ trong ô nhập liệu của Telegram hoặc của panel
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
       // Nếu đang gõ trong panel thì vẫn cho phép bật/tắt
       if (!panel.contains(e.target)) return; 
    }

    keysPressed[e.key.toLowerCase()] = true;
    
    if (keysPressed['i'] && keysPressed['o'] && keysPressed['p']) {
      panel.classList.toggle('hidden-panel');
      keysPressed = {}; // Reset để không bị lặp
    }
  });

  document.addEventListener('keyup', (e) => {
    delete keysPressed[e.key.toLowerCase()];
  });
  // =======================================================

  // Kéo thả
  let isDragging = false, startX, startY, initialX, initialY;
  panel.style.right = 'auto';
  panel.style.left = (window.innerWidth - 280) + 'px';

  panel.addEventListener('mousedown', (e) => {
    if (e.target.closest('.ctrl-btn') || ['TEXTAREA', 'INPUT', 'BUTTON', 'LABEL'].includes(e.target.tagName)) return;
    isDragging = true; startX = e.clientX; startY = e.clientY;
    initialX = panel.offsetLeft; initialY = panel.offsetTop;
    panel.style.transition = 'none';
  });

  document.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    panel.style.left = (initialX + e.clientX - startX) + 'px';
    panel.style.top = (initialY + e.clientY - startY) + 'px';
  });

  document.addEventListener('mouseup', () => { 
    isDragging = false; 
    panel.style.transition = 'opacity 0.3s, transform 0.3s'; 
  });
  
  document.getElementById('final-toggle').addEventListener('click', (e) => { e.stopPropagation(); panel.classList.add('minimized'); });
  panel.addEventListener('click', () => { if (panel.classList.contains('minimized')) panel.classList.remove('minimized'); });

  // ================= LOGIC SPAM CHUẨN =================
  let running = false;
  let interval = null;
  let sentCount = 0;
  
  const btn = document.getElementById('final-btn');
  const delayInput = document.getElementById('final-delay');
  const msgInput = document.getElementById('final-msg');

  function fireOnce() {
    const box = document.querySelector('.input-message-input[contenteditable="true"]');
    if (!box) return;
    
    box.focus();
    document.execCommand('selectAll', false, null);
    document.execCommand('delete', false, null);
    document.execCommand('insertText', false, msgInput.value);
    
    box.dispatchEvent(new InputEvent('input', { bubbles: true }));
    box.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true }));
    
    // Cập nhật số lượng lên nút
    sentCount++;
    btn.textContent = `Dừng (Đã gửi: ${sentCount})`;
  }

  btn.addEventListener('click', () => {
    if (running) {
      running = false;
      clearInterval(interval);
      btn.textContent = 'Spam';
      btn.classList.remove('stop');
      sentCount = 0;
    } else {
      running = true;
      sentCount = 0;
      btn.textContent = `Dừng (Đã gửi: 0)`;
      btn.classList.add('stop');
      
      let delay = parseInt(delayInput.value, 10) || 0;
      if (delay < 10) delay = 10; // Khóa an toàn
      
      // Bắn phát đầu tiên ngay lập tức
      fireOnce();

      // Lặp lại theo khoảng thời gian
      interval = setInterval(() => {
        if (!running) return;
        fireOnce();
      }, delay);
    }
  });

  document.getElementById('final-close').addEventListener('click', (e) => {
    e.stopPropagation();
    running = false;
    clearInterval(interval);
    panel.remove();
    style.remove();
  });

})();
