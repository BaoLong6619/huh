    btn.Size = UDim2.new(1, -5, 0, 38); btn.BackgroundColor3 = Color3.fromRGB(235, 235, 235); btn.Font = Enum.Font.SourceSansBold; btn.TextSize = 16
    rs.RenderStepped:Connect(function()
        btn.Text = name .. (Config[configKey] and ": BẬT" or ": TẮT")
        btn.TextColor3 = Config[configKey] and Config.MainColor or Color3.fromRGB(180, 0, 0)
        updateShortcuts()
    end)
    btn.MouseButton1Click:Connect(function() Config[configKey] = not Config[configKey]; if callback then callback(Config[configKey]) end end)
end

