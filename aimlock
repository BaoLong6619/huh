-- 5. CORE LOGIC
local fovCircle = Instance.new("Frame", sg); fovCircle.AnchorPoint = Vector2.new(0.5, 0.5); fovCircle.Position = UDim2.new(0.5, 0, 0.5, 0); fovCircle.BackgroundTransparency = 1; local stroke = Instance.new("UIStroke", fovCircle); stroke.Color = Config.MainColor; stroke.Thickness = 2; Instance.new("UICorner", fovCircle).CornerRadius = UDim.new(1, 0)

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

rs.RenderStepped:Connect(function()
    fovCircle.Visible = Config.ShowFOV; fovCircle.Size = UDim2.new(0, Config.FOV * 2, 0, Config.FOV * 2)
    fovCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
    
    if Config.Aimbot then
        local target = nil; local maxDist = Config.FOV
        local center = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
        for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= lp and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                local part = p.Character:FindFirstChild(Config.TargetPart)
                if part then
                    local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local mag = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if mag < maxDist then
                            rayParams.FilterDescendantsInstances = {lp.Character, camera}
                            local dir = (part.Position - camera.CFrame.Position)
                            local result = workspace:Raycast(camera.CFrame.Position, dir, rayParams)
                            local clear = (not Config.CheckWall) or (result and result.Instance and result.Instance:IsDescendantOf(p.Character))
                            if clear then
                                maxDist = mag; target = part
                            end
                        end
                    end
                end
            end
        end
        if target and (uis:IsMouseButtonPressed(Config.AimKey) or uis.TouchEnabled) then
            local goal = CFrame.new(camera.CFrame.Position, target.Position)
            local alpha = 1 / math.max(Config.Smoothness, 1)
            camera.CFrame = camera.CFrame:Lerp(goal, alpha)
        end
    end

    -- ESP LOGIC
    for _, p in pairs(game.Players:GetPlayers()) do
        if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local root = p.Character.HumanoidRootPart
            if p.Character.Humanoid.Health > 0 then
                local hl = p.Character:FindFirstChild("LBE_HL")
                if Config.EspHighlight then
                    if not hl then hl = Instance.new("Highlight", p.Character); hl.Name = "LBE_HL"; hl.FillColor = Config.MainColor; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop end
                    hl.Enabled = true
                elseif hl then hl.Enabled = false end
                
                local bgu = root:FindFirstChild("LBE_BGU")
                if Config.EspPlayer or Config.EspWeapon then
                    if not bgu then
                        bgu = Instance.new("BillboardGui", root); bgu.Name = "LBE_BGU"; bgu.AlwaysOnTop = true; bgu.Size = UDim2.new(0, 250, 0, 80); bgu.ExtentsOffset = Vector3.new(0, 4.5, 0)
                        local t = Instance.new("TextLabel", bgu); t.Size = UDim2.new(1, 0, 1, 0); t.BackgroundTransparency = 1; t.TextColor3 = Color3.new(1,1,1); t.Font = Enum.Font.SourceSansBold; t.TextSize = 25; Instance.new("UIStroke", t).Thickness = 2
                    end
                    local tool = p.Character:FindFirstChildOfClass("Tool"); local weapon = tool and tool.Name or "Không"
                    bgu.TextLabel.Text = (Config.EspPlayer and p.Name .. "\n" or "") .. (Config.EspWeapon and "[ " .. weapon .. " ]" or "")
                    bgu.Enabled = true
                elseif bgu then bgu.Enabled = false end
            end
        end
    end
end)

-- 6. KEYBIND
-- T = ẩn/hiện UI
-- Y = bật/tắt aim nhanh
-- B = đổi Đầu ↔ Thân
-- H = đổi nút aim (Chuột Trái ↔ Chuột Phải)
uis.InputBegan:Connect(function(input, gpe)
    if input.KeyCode == Enum.KeyCode.T then
        main.Visible = not main.Visible
        return
    end
    if gpe then return end

    if input.KeyCode == Enum.KeyCode.Y then
        Config.Aimbot = not Config.Aimbot
        updateShortcuts()
    elseif input.KeyCode == Enum.KeyCode.B then
        if Config.TargetPart == "Head" then
            SetTargetPart("HumanoidRootPart")
        else
            SetTargetPart("Head")
        end
    elseif input.KeyCode == Enum.KeyCode.H then
        if Config.AimKey == Enum.UserInputType.MouseButton2 then
            Config.AimKey = Enum.UserInputType.MouseButton1
            print("[long béo] Đổi nút aim → CHUỘT TRÁI")
        else
            Config.AimKey = Enum.UserInputType.MouseButton2
            print("[long béo] Đổi nút aim → CHUỘT PHẢI")
        end
    end
end)
