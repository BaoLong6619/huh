        MsgButton.TextColor3 = Color3.fromRGB(230, 230, 230)
        MsgButton.Font = Enum.Font.SourceSans
        MsgButton.TextSize = 15
        MsgButton.TextXAlignment = Enum.TextXAlignment.Left
        MsgButton.Parent = ChatTab

        local MsgCorner = Instance.new("UICorner")
        MsgCorner.CornerRadius = UDim.new(0, 5)
        MsgCorner.Parent = MsgButton

        -- Click gửi ngay lập tức
