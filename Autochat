        TextLabel.Size = UDim2.new(1, -50, 1, 0)
        TextLabel.Position = UDim2.new(0, 10, 0, 0)
        TextLabel.BackgroundTransparency = 1
        TextLabel.Text = msg
        TextLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        TextLabel.Font = Enum.Font.SourceSans
        TextLabel.TextSize = 14
        TextLabel.TextXAlignment = Enum.TextXAlignment.Left
        TextLabel.Parent = ItemFrame

        local DelButton = Instance.new("TextButton")
        DelButton.Size = UDim2.new(0, 40, 1, 0)
        DelButton.Position = UDim2.new(1, -40, 0, 0)
        DelButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        DelButton.Text = "❌"
        DelButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        DelButton.Font = Enum.Font.SourceSansBold
