local ESPConfig = { Highlight = false, Distance = false, Chams = false, GlowPulse = false, MaxDistance = 300 }
local ActiveHighlights = {}
local ActiveChams = {}
local ActiveToggles = {}


task.spawn(function()
    while task.wait(0.1) do
        -- Sửa lỗi an toàn: Kiểm tra tuyệt đối sự tồn tại của nhân vật LocalPlayer tránh crash chuỗi nil chain
        local lpChar = LocalPlayer.Character
        local lpHRP = lpChar and lpChar:FindFirstChild("HumanoidRootPart")

        if lpHRP then
       
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local char = player.Character
                    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                        local hrp = char.HumanoidRootPart
                        local hum = char.Humanoid
                        local head = char:FindFirstChild("Head")
                        
                        
                        local distance = (lpHRP.Position - hrp.Position).Magnitude

                        
                        if distance < ESPConfig.MaxDistance and hum.Health > 0 then
                            
                            
                            if ESPConfig.Highlight then
                                local hl = ActiveHighlights[player] or char:FindFirstChild("LongBeo_HL")
                                if not hl then
                                    hl = Instance.new("Highlight")
                                    hl.Name = "LongBeo_HL"
                                    hl.FillTransparency = 0.6
                                    hl.OutlineTransparency = 0
                                    hl.Parent = char
                                    ActiveHighlights[player] = hl
                                end
                                hl.FillColor = Color3.fromRGB(255 * (1 - (hum.Health/hum.MaxHealth)), 255 * (hum.Health/hum.MaxHealth), 0)
                                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                
                                
                                if ESPConfig.GlowPulse then
                                    hl.OutlineTransparency = math.clamp(math.sin(tick() * 4), 0, 0.8)
                                else
                                    hl.OutlineTransparency = 0
                                end
                            else
                                if ActiveHighlights[player] then ActiveHighlights[player]:Destroy() ActiveHighlights[player] = nil end
                                local oldHl = char:FindFirstChild("LongBeo_HL") if oldHl then oldHl:Destroy() end
                            end

                            
                            if ESPConfig.Chams then
                                if not ActiveChams[player] then
                                    local box = Instance.new("BoxHandleAdornment")
                                    box.Name = "LongBeo_Cham"
                                    box.Size = Vector3.new(4, 5.5, 1)
                                    box.AlwaysOnTop = true
                                    box.ZIndex = 5
                                    box.Adornee = char
                                    box.Color3 = Color3.fromRGB(0, 170, 255)
                                    box.Transparency = 0.5
                                    box.Parent = ScreenGui
                                    ActiveChams[player] = box
                                else
                                    ActiveChams[player].Adornee = char
                                end
                            else
                                if ActiveChams[player] then ActiveChams[player]:Destroy() ActiveChams[player] = nil end
                            end

                            
                            if ESPConfig.Distance and head then
                                local bg = head:FindFirstChild("LongBeo_ESP_Bill")
                                if not bg then
                                    bg = Instance.new("BillboardGui")
                                    bg.Name = "LongBeo_ESP_Bill"
                                    bg.Size = UDim2.new(0, 130, 0, 45)
                                    bg.StudsOffset = Vector3.new(0, 3, 0)
                                    bg.AlwaysOnTop = true
                                    
                                    local tl = Instance.new("TextLabel")
                                    tl.Name = "Info"
                                    tl.Size = UDim2.new(1, 0, 0, 20)
                                    tl.BackgroundTransparency = 1
                                    tl.TextColor3 = Color3.fromRGB(255, 255, 255)
                                    tl.TextSize = 12
                                    tl.Font = Enum.Font.GothamBold
                                    tl.TextStrokeTransparency = 0.4
                                    tl.Parent = bg

                                    local barBg = Instance.new("Frame")
                                    barBg.Name = "BarBg"
                                    barBg.Size = UDim2.new(0, 80, 0, 4)
                                    barBg.Position = UDim2.new(0.5, -40, 0, 22)
                                    barBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                                    barBg.BorderSizePixel = 0
                                    barBg.Parent = bg

                                    local barMain = Instance.new("Frame")
                                    barMain.Name = "BarMain"
                                    barMain.Size = UDim2.new(1, 0, 1, 0)
                                    barMain.BorderSizePixel = 0
                                    barMain.Parent = barBg

                                    bg.Parent = head
                                end
                                
                                if bg:FindFirstChild("Info") then
                                    bg.Info.Text = player.Name .. " [" .. math.floor(distance) .. "m]"
                                    bg.BarBg.BarMain.Size = UDim2.new(hum.Health / hum.MaxHealth, 0, 1, 0)
                                    
                                    
                                    if hum.Health > 60 then
                                        bg.BarBg.BarMain.BackgroundColor3 = Color3.fromRGB(0, 255, 150) 
                                    elseif hum.Health > 25 then
                                        bg.BarBg.BarMain.BackgroundColor3 = Color3.fromRGB(255, 200, 0) 
                                    else
                                        bg.BarBg.BarMain.BackgroundColor3 = Color3.fromRGB(255, 70, 70) 
                                    end
                                end
                            else
                                local oldBg = head and head:FindFirstChild("LongBeo_ESP_Bill")
                                if oldBg then oldBg:Destroy() end
                            end

                        else
                            
                            if ActiveHighlights[player] then ActiveHighlights[player]:Destroy() ActiveHighlights[player] = nil end
                            if ActiveChams[player] then ActiveChams[player]:Destroy() ActiveChams[player] = nil end
                            local oldBg = head and head:FindFirstChild("LongBeo_ESP_Bill") if oldBg then oldBg:Destroy() end
                        end
                    end
                end
            end
        end
    end
end)


