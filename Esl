local function AddToggleiOS(text, callback)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, -10, 0, 46)
    card.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
    card.ZIndex = 3
    card.Parent = ScrollFrame

    local cardCorner = Instance.new("UICorner")
    cardCorner.CornerRadius = UDim.new(0, 8)
    cardCorner.Parent = card

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -70, 1, 0)
    label.Position = UDim2.new(0, 14, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(230, 230, 235)
    label.TextSize = 13
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 3
    label.Parent = card

    local switch = Instance.new("TextButton")
    switch.Size = UDim2.new(0, 44, 0, 24)
    switch.Position = UDim2.new(1, -54, 0.5, -12)
    switch.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
    switch.Text = ""
    switch.ZIndex = 3
    switch.Parent = card

    local switchCorner = Instance.new("UICorner")
    switchCorner.CornerRadius = UDim.new(1, 0)
    switchCorner.Parent = switch

    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 18, 0, 18)
    circle.Position = UDim2.new(0, 3, 0.5, -9)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.BorderSizePixel = 0
    circle.ZIndex = 3
    circle.Parent = switch

    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = circle

    local state = false
    
    local function UpdateState(targetState)
        state = targetState
        if state then
            TweenService:Create(switch, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(0, 170, 255)}):Play()
            TweenService:Create(circle, TweenInfo.new(0.15), {Position = UDim2.new(1, -21, 0.5, -9)}):Play()
        else
            TweenService:Create(switch, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(55, 55, 65)}):Play()
            TweenService:Create(circle, TweenInfo.new(0.15), {Position = UDim2.new(0, 3, 0.5, -9)}):Play()
        end
        callback(state)
    end

    switch.MouseButton1Click:Connect(function()
        TweenService:Create(card, TweenInfo.new(0.1), {Size = UDim2.new(1, -4, 0, 48)}):Play()
        task.wait(0.1)
        TweenService:Create(card, TweenInfo.new(0.1), {Size = UDim2.new(1, -10, 0, 46)}):Play()
        UpdateState(not state)
    end)

    ActiveToggles[text] = UpdateState
end


local function AddPresetButton(name, configs)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 40)
    btn.Text = "⚡ CẤU HÌNH NHANH: " .. name
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamBold
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.ZIndex = 3
    btn.Parent = ScrollFrame

    local uic = Instance.new("UICorner")
    uic.CornerRadius = UDim.new(0, 8)
    uic.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(55, 55, 70)
    stroke.Parent = btn

    btn.MouseButton1Click:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(0, 170, 255)}):Play()
        task.wait(0.1)
        TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(40, 40, 50)}):Play()
        
        for toggleName, targetState in pairs(configs) do
            if ActiveToggles[toggleName] then ActiveToggles[toggleName](targetState) end
        end
    end)
end


